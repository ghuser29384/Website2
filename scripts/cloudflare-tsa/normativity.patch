+import fixtures from './tsa-fixtures.json';
+import { runTimestampConformance } from './tsa-conformance.mjs';
+
+// Separate local-only test entry. It exposes no production application route.
+export default { async fetch(request) {
+  const url = new URL(request.url);
+  if (!['127.0.0.1', 'localhost'].includes(url.hostname) || url.pathname !== '/synthetic-conformance') {
+    return new Response('Not found', { status: 404 });
+  }
+  try { return Response.json(await runTimestampConformance(fixtures)); }
+  catch { return Response.json({ status: 'FAIL_SYNTHETIC_CRYPTO' }, { status: 500 }); }
+} };
