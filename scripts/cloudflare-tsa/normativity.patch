+import { Buffer } from 'node:buffer';
+import * as asn1 from 'asn1js';
+import {
+  TimeStampReq, TimeStampResp, SignedData, TSTInfo, Certificate,
+  IssuerAndSerialNumber, GeneralNames,
+  CertificateChainValidationEngine, CryptoEngine,
+} from 'pkijs';
+
+const OID = {
+  sha256: '2.16.840.1.101.3.4.2.1', signedData: '1.2.840.113549.1.7.2',
+  tstInfo: '1.2.840.113549.1.9.16.1.4', contentType: '1.2.840.113549.1.9.3',
+  messageDigest: '1.2.840.113549.1.9.4', ess1: '1.2.840.113549.1.9.16.2.12',
+  ess2: '1.2.840.113549.1.9.16.2.47', timestamp: '1.3.6.1.5.5.7.3.8',
+};
+const need = (ok, message) => { if (!ok) throw new Error('Invalid timestamp proof: ' + message); };
+const bytes = value => Buffer.from(value);
+const same = (a, b) => bytes(a).equals(bytes(b));
+function decode(input) {
+  const data = bytes(input);
+  const result = asn1.fromBER(data);
+  need(result.offset === data.length && !result.result.error, 'malformed or trailing ASN.1');
+  return result.result;
+}
+function sequence(value) {
+  need(value instanceof asn1.Sequence, 'expected sequence');
+  return value.valueBlock.value;
+}
+function attribute(signer, oid, required = true) {
+  const found = signer.signedAttrs?.attributes.filter(a => a.type === oid) || [];
+  if (!required && found.length === 0) return null;
+  need(found.length === 1 && found[0].values.length === 1, 'missing or duplicate signed attribute');
+  return found[0].values[0];
+}
+function pemCertificates(pem) {
+  const blocks = [...pem.matchAll(/-----BEGIN CERTIFICATE-----([\s\S]*?)-----END CERTIFICATE-----/g)];
+  need(blocks.length > 0, 'no configured trust certificates');
+  return blocks.map(([, body]) => {
+    const b64 = body.replace(/\s/g, '');
+    need(/^[A-Za-z0-9+/]+={0,2}$/.test(b64), 'invalid certificate encoding');
+    return new Certificate({ schema: decode(Buffer.from(b64, 'base64')) });
+  });
+}
+function nameMatches(name, cert, issuer = false) {
+  if (name.type === 4) return name.value.isEqual(issuer ? cert.issuer : cert.subject);
+  const extension = cert.extensions?.find(e => e.extnID === (issuer ? '2.5.29.18' : '2.5.29.17'));
+  return Boolean(extension?.parsedValue?.altNames?.some(n => same(n.toSchema().toBER(), name.toSchema().toBER())));
+}
+
+// ESS binds the signer certificate to the signed attributes. A signature and
+// trusted chain alone do not prevent substitution of a same-key certificate.
+async function checkEss(value, version, signerCert, path, engine) {
+  const certIds = sequence(sequence(value)[0]);
+  need(certIds.length > 0, 'empty ESS certificate list');
+  for (let index = 0; index < certIds.length; index++) {
+    const fields = [...sequence(certIds[index])];
+    let hash = version === 1 ? 'SHA-1' : 'SHA-256';
+    if (version === 2 && fields[0] instanceof asn1.Sequence) {
+      const algorithm = sequence(fields.shift())[0];
+      need(algorithm instanceof asn1.ObjectIdentifier, 'invalid ESS hash algorithm');
+      hash = engine.getAlgorithmByOID(algorithm.valueBlock.toString(), true).name;
+    }
+    const digest = fields.shift();
+    need(digest instanceof asn1.OctetString, 'invalid ESS certificate digest');
+    const candidates = index === 0 ? [signerCert] : path;
+    let matched;
+    for (const cert of candidates) {
+      if (same(await engine.digest(hash, cert.toSchema().toBER()), digest.getValue())) { matched = cert; break; }
+    }
+    need(matched, 'ESS certificate binding mismatch');
+    if (fields.length) {
+      const issuerSerial = sequence(fields.shift());
+      need(issuerSerial.length === 2 && issuerSerial[1] instanceof asn1.Integer, 'invalid ESS issuer/serial');
+      const names = new GeneralNames({ schema: issuerSerial[0] }).names;
+      need(names.some(name => nameMatches(name, matched, true)) && matched.serialNumber.isEqual(issuerSerial[1]), 'ESS issuer/serial mismatch');
+    }
+    need(fields.length === 0, 'unexpected ESS fields');
+  }
+}
+
+export async function verifyTimestampResponse({ token, query, pem, now = new Date() }) {
+  const engine = new CryptoEngine({ name: 'workers-webcrypto', crypto: globalThis.crypto });
+  const request = new TimeStampReq({ schema: decode(query) });
+  const response = new TimeStampResp({ schema: decode(token) });
+  need(request.version === 1 && request.nonce && request.certReq, 'unexpected request');
+  need([0, 1].includes(response.status.status) && !response.status.failInfo, 'TSA rejected request');
+  need(response.timeStampToken?.contentType === OID.signedData, 'not CMS signed data');
+  const signed = new SignedData({ schema: response.timeStampToken.content });
+  need(signed.signerInfos.length === 1, 'expected one TSA signer');
+  need(signed.encapContentInfo.eContentType === OID.tstInfo && signed.encapContentInfo.eContent, 'missing TSTInfo');
+  const content = signed.encapContentInfo.eContent.getValue();
+  const info = new TSTInfo({ schema: decode(content) });
+  need(info.version === 1 && Number.isFinite(info.genTime.getTime()), 'invalid TSTInfo');
+  need(!info.extensions?.some(e => e.critical), 'unrecognized critical TSTInfo extension');
+  need(request.messageImprint.hashAlgorithm.algorithmId === OID.sha256 &&
+    info.messageImprint.hashAlgorithm.algorithmId === OID.sha256 &&
+    request.messageImprint.hashedMessage.getValue().byteLength === 32 &&
+    same(info.messageImprint.hashedMessage.getValue(), request.messageImprint.hashedMessage.getValue()), 'message imprint mismatch');
+  need(info.nonce?.isEqual(request.nonce), 'nonce mismatch');
+  need(!request.reqPolicy || info.policy === request.reqPolicy, 'policy mismatch');
+
+  const signer = signed.signerInfos[0];
+  const certificates = (signed.certificates || []).filter(c => c instanceof Certificate);
+  let signerCert;
+  if (signer.sid instanceof IssuerAndSerialNumber) {
+    signerCert = certificates.find(c => c.issuer.isEqual(signer.sid.issuer) && c.serialNumber.isEqual(signer.sid.serialNumber));
+  } else {
+    const sid = signer.sid.idBlock.isConstructed
+      ? signer.sid.valueBlock.value[0].valueBlock.valueHexView : signer.sid.valueBlock.valueHexView;
+    for (const cert of certificates) {
+      const keyId = await engine.digest('SHA-1', cert.subjectPublicKeyInfo.subjectPublicKey.valueBlock.valueHexView);
+      if (same(keyId, sid)) { signerCert = cert; break; }
+    }
+  }
+  need(signerCert, 'signer certificate missing');
+  const eku = signerCert.extensions?.filter(e => e.extnID === '2.5.29.37') || [];
+  need(eku.length === 1 && eku[0].critical && eku[0].parsedValue?.keyPurposes?.length === 1 &&
+    eku[0].parsedValue.keyPurposes[0] === OID.timestamp, 'signer is not exclusively a timestamp authority');
+  const usage = signerCert.extensions?.find(e => e.extnID === '2.5.29.15');
+  if (usage) {
+    const bits = usage.parsedValue?.valueBlock.valueHexView;
+    need(bits?.length === 1 && (bits[0] & 0xc0) !== 0 && (bits[0] & 0x3f) === 0, 'invalid timestamp signing key usage');
+  }
+  need(!info.tsa || nameMatches(info.tsa, signerCert), 'TSA name mismatch');
+
+  const contentType = attribute(signer, OID.contentType);
+  need(contentType instanceof asn1.ObjectIdentifier && contentType.valueBlock.toString() === OID.tstInfo, 'signed content type mismatch');
+  const digest = attribute(signer, OID.messageDigest);
+  const hash = engine.getAlgorithmByOID(signer.digestAlgorithm.algorithmId, true).name;
+  need(signed.digestAlgorithms.some(a => a.algorithmId === signer.digestAlgorithm.algorithmId), 'missing signer digest algorithm');
+  need(digest instanceof asn1.OctetString && same(await engine.digest(hash, content), digest.getValue()), 'signed content digest mismatch');
+  need(signer.signedAttrs.encodedValue.byteLength > 0, 'missing encoded signed attributes');
+  // Use PKI.js's public signature primitive. Its high-level TST verifier hashes
+  // the original data, which is unavailable here: the app stores a digest.
+  // We compare that imprint above, and independently verify CMS bytes below.
+  const valid = await engine.verifyWithPublicKey(signer.signedAttrs.encodedValue, signer.signature,
+    signerCert.subjectPublicKeyInfo, signer.signatureAlgorithm,
+    signer.signatureAlgorithm.algorithmId === '1.2.840.113549.1.1.1' ? hash : undefined);
+  need(valid, 'signature mismatch');
+  const chain = await new CertificateChainValidationEngine({
+    certs: [...certificates.filter(c => c !== signerCert), signerCert],
+    trustedCerts: pemCertificates(pem), checkDate: now,
+    crls: (signed.crls || []).filter(c => 'thisUpdate' in c),
+  }).verify({ passedWhenNotRevValues: true }, engine);
+  // Original openssl ts -verify uses configured CA certificates and current
+  // certificate validity, without enabling CRL downloads or revocation flags.
+  need(chain.result && chain.certificatePath?.length, 'untrusted or invalid certificate chain');
+  const ess1 = attribute(signer, OID.ess1, false), ess2 = attribute(signer, OID.ess2, false);
+  need(ess1 || ess2, 'missing ESS certificate binding');
+  if (ess1) await checkEss(ess1, 1, signerCert, chain.certificatePath, engine);
+  if (ess2) await checkEss(ess2, 2, signerCert, chain.certificatePath, engine);
+}
