+import assert from 'node:assert/strict';
+import { readFile, writeFile, mkdir, copyFile } from 'node:fs/promises';
+import { resolve, dirname, basename } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { builtinModules, createRequire } from 'node:module';
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { derivePrismaSchema, bundleJoseImport, bundleAppEntrypoint, bundleTimestampService } from './transforms.mjs';
+
+const here = dirname(fileURLToPath(import.meta.url)), root = resolve(here, '..');
+assert.equal(process.env.CF_COMPAT_TEST, '1', 'Compatibility test context required');
+assert.ok(process.argv.slice(2).every(x => x === '--generate-only' || x === '--bundle-only'));
+for (const key of ['DATABASE_URL', 'DIRECT_URL']) {
+  const url = new URL(process.env[key] || '');
+  assert.equal(url.protocol, 'postgresql:');
+  assert.equal(url.hostname, '127.0.0.1');
+  assert.equal(url.port, '15432');
+  assert.equal(url.pathname, '/synthetic');
+}
+if (!process.argv.includes('--bundle-only')) {
+  const schema = await readFile(resolve(root, 'server/prisma/schema.prisma'), 'utf8');
+  await writeFile(resolve(here, 'schema.prisma'), derivePrismaSchema(schema));
+  execFileSync(process.execPath, [resolve(root, 'server/node_modules/prisma/build/index.js'),
+    'generate', '--schema', resolve(here, 'schema.prisma')], { cwd: root, stdio: 'inherit' });
+}
+if (process.argv.includes('--generate-only')) process.exit(0);
+
+const { build } = await import('esbuild');
+const builtins = new Set(builtinModules.map(x => x.replace(/^node:/, '')));
+const wasm = new Map(), transformed = new Set();
+const overrides = new Map([
+  [resolve(root, 'server/src/middleware/auth.ts'), bundleJoseImport],
+  [resolve(root, 'server/src/services/cryptoSigning.ts'), bundleJoseImport],
+  [resolve(root, 'server/src/app.ts'), bundleAppEntrypoint],
+  [resolve(root, 'server/src/services/tsa.ts'), bundleTimestampService],
+]);
+await mkdir(resolve(here, 'dist'), { recursive: true });
+const result = await build({
+  absWorkingDir: root,
+  entryPoints: [resolve(here, 'worker.ts')],
+  outfile: resolve(here, 'dist/worker.mjs'),
+  bundle: true, format: 'esm', platform: 'node', target: 'es2022',
+  mainFields: ['module', 'main'], conditions: ['workerd', 'worker', 'node'],
+  external: ['cloudflare:*', 'pg-native'], metafile: true,
+  banner: { js: 'import { createRequire as __nodeCreateRequire } from "node:module"; const require = __nodeCreateRequire(import.meta.url);' },
+  plugins: [{ name: 'preserve-server-behavior-on-workers', setup(builder) {
+    builder.onResolve({ filter: /^(node:)?[a-z_]+(?:\/[a-z_]+)?$/ }, args => {
+      const name = args.path.replace(/^node:/, '');
+      if (builtins.has(name)) return { path: 'node:' + name, external: true };
+    });
+    builder.onResolve({ filter: /(^|\/)db\/prisma(?:\.ts)?$/ }, args => {
+      const path = resolve(args.resolveDir, args.path).replace(/\.ts$/, '');
+      if (path === resolve(root, 'server/src/db/prisma')) return { path: resolve(here, 'prisma.ts') };
+    });
+    builder.onLoad({ filter: /\.ts$/ }, async args => {
+      const transform = overrides.get(args.path);
+      if (transform) {
+        transformed.add(args.path);
+        return { contents: transform(await readFile(args.path, 'utf8')), loader: 'ts', resolveDir: dirname(args.path) };
+      }
+    });
+    builder.onResolve({ filter: /\.wasm(?:\?module)?$/ }, args => {
+      const specifier = args.path.replace(/\?module$/, '');
+      const path = createRequire(resolve(args.resolveDir, '__resolve.cjs')).resolve(specifier);
+      const name = createHash('sha256').update(path).digest('hex').slice(0, 12) + '-' + basename(path);
+      wasm.set(path, name);
+      return { path: './' + name, external: true };
+    });
+  } }],
+});
+assert.equal(transformed.size, overrides.size, 'Every known runtime adaptation must be included');
+const inputs = Object.keys(result.metafile.inputs);
+assert.ok(inputs.some(x => /iconv-lite\/lib\/streams\.js$/.test(x)), 'Real encoding streams must be retained');
+assert.ok(!inputs.some(x => /server\/src\/db\/prisma\.ts$/.test(x)), 'Native Prisma singleton leaked into Workers');
+assert.ok(!inputs.some(x => /\.node$/.test(x)), 'Native addon in Workers bundle');
+for (const [path, name] of wasm) await copyFile(path, resolve(here, 'dist', name));
+await writeFile(resolve(here, 'dist/build-meta.json'), JSON.stringify(result.metafile, null, 2) + '\n');
+console.log(JSON.stringify({ status: 'BUNDLED_NOT_FEATURE_ACCEPTANCE', wasmModules: wasm.size,
+  originalApplicationFilesModified: 0, timestampProofCompatibility: 'CANDIDATE_REQUIRES_CRYPTO_AND_WORKERS_PROOF' }));
