+++ b/cloudflare/tsa-batch.test.mjs
@@ -0,0 +1,57 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+import { bundleTimestampService } from './transforms.mjs';
+
+const source = await readFile(new URL('../server/src/services/tsa.ts', import.meta.url), 'utf8');
+const transformed = bundleTimestampService(source);
+const batch = transformed.slice(transformed.indexOf('export const timestampPendingCheckpoints'));
+function loadBatch(request, metric) {
+  const js = stripTypeScriptTypes(batch).replace('export const ', 'const ');
+  return new Function('requestRfc3161Timestamp', 'recordCommitmentMetric', js + '\nreturn timestampPendingCheckpoints;')(request, metric);
+}
+async function withEnv(values, operation) {
+  const names = ['TSA_URL', 'TSA_CA_FILE', 'TSA_CA_PEM', 'TSA_BATCH_SIZE', 'TSA_CERT_FINGERPRINT'];
+  const previous = Object.fromEntries(names.map(n => [n, process.env[n]]));
+  try {
+    for (const n of names) { if (values[n] === undefined) delete process.env[n]; else process.env[n] = values[n]; }
+    await operation();
+  } finally { for (const n of names) { if (previous[n] === undefined) delete process.env[n]; else process.env[n] = previous[n]; } }
+}
+
+test('Workers transform preserves entire checkpoint loop byte for byte and rejects drift', () => {
+  assert.equal(batch, source.slice(source.indexOf('export const timestampPendingCheckpoints')));
+  assert.doesNotMatch(transformed, /child_process|mkdtemp|openssl/);
+  assert.throws(() => bundleTimestampService(source + '\n'), /review required/);
+});
+test('unconfigured timestamp job remains skipped without database access', async () => {
+  await withEnv({}, async () => {
+    const result = await loadBatch(() => assert.fail('no request'), () => {})({});
+    assert.equal(result.timestamped, 0); assert.match(result.skipped, /not configured/);
+  });
+});
+for (const verified of [false, true]) test('batch preserves binary records, metadata and verified flag: ' + verified, async () => {
+  await withEnv({ TSA_URL: 'https://tsa.invalid', TSA_BATCH_SIZE: '2', TSA_CERT_FINGERPRINT: 'synthetic-metadata',
+    ...(verified ? { TSA_CA_PEM: 'synthetic-ca' } : {}) }, async () => {
+    const records = [], metrics = []; const binary = Buffer.from([0, 255, 17, 128]);
+    const result = await loadBatch(async root => { assert.equal(root, 'ab'.repeat(32)); return binary; }, (...m) => metrics.push(m))({
+      auditCheckpoint: { findMany: async query => {
+        assert.deepEqual(query, { where: { timestamp: null }, orderBy: { createdAt: 'asc' }, take: 2 });
+        return [{ id: 'synthetic-checkpoint', rootHash: 'ab'.repeat(32) }];
+      } }, auditTimestamp: { create: async value => records.push(value.data) },
+    });
+    assert.deepEqual(result, { timestamped: 1 }); assert.equal(records.length, 1);
+    assert.deepEqual(Buffer.from(records[0].timestampTokenDer), binary);
+    assert.equal(Boolean(records[0].verifiedAt), verified);
+    assert.equal(records[0].certificateFingerprint, 'synthetic-metadata');
+    assert.equal(metrics[0][1].verified, verified);
+  });
+});
+test('failed proof prevents persistence and success metrics', async () => {
+  await withEnv({ TSA_URL: 'https://tsa.invalid', TSA_CA_PEM: 'synthetic-ca' }, async () => {
+    const job = loadBatch(async () => { throw new Error('invalid signature'); }, () => assert.fail('no success metric'));
+    await assert.rejects(job({ auditCheckpoint: { findMany: async () => [{ id: 'synthetic', rootHash: 'ab'.repeat(32) }] },
+      auditTimestamp: { create: async () => assert.fail('no persistence') } }), /invalid signature/);
+  });
+});
diff --git a/cloudflare/tsa-client.mjs b/cloudflare/tsa-client.mjs
new file mode 100644
index 0000000..f20b000
--- /dev/null
+++ b/cloudflare/tsa-client.mjs
@@ -0,0 +1,50 @@
+import { Buffer } from 'node:buffer';
+
+const sha256Identifier = Buffer.from('300d06096086480165030402010500', 'hex');
+const der = (tag, value) => {
+  if (value.length >= 128) throw new Error('Unexpected timestamp request length');
+  return Buffer.concat([Buffer.from([tag, value.length]), value]);
+};
+
+// rootHash is already SHA-256. Hashing it again would timestamp different data.
+export function createTimestampQuery(rootHash, nonceBytes = crypto.getRandomValues(new Uint8Array(8))) {
+  if (typeof rootHash !== 'string' || !/^[\da-f]{64}$/i.test(rootHash)) {
+    throw new Error('Timestamp requires a 32-byte SHA-256 hex digest.');
+  }
+  if (!(nonceBytes instanceof Uint8Array) || nonceBytes.length !== 8) throw new Error('Invalid timestamp nonce.');
+  let nonce = Buffer.from(nonceBytes);
+  while (nonce.length > 1 && nonce[0] === 0) nonce = nonce.subarray(1);
+  if (nonce[0] & 128) nonce = Buffer.concat([Buffer.from([0]), nonce]);
+  return der(0x30, Buffer.concat([
+    Buffer.from([2, 1, 1]),
+    der(0x30, Buffer.concat([sha256Identifier, der(4, Buffer.from(rootHash, 'hex'))])),
+    der(2, nonce),
+    Buffer.from([1, 1, 255]),
+  ]));
+}
+
+export async function requestTimestamp(rootHash, {
+  env = process.env, fetchImpl = globalThis.fetch,
+  readCaFile, verifyResponse, createQuery = createTimestampQuery,
+} = {}) {
+  if (!env.TSA_URL) throw new Error('TSA_URL is not configured.');
+  const query = createQuery(rootHash);
+  if (!fetchImpl) throw new Error('Global fetch is not available for TSA requests.');
+  // Preserve FILE precedence, PEM escaped-newline support and unverified mode.
+  // Read a configured trust source before contacting the TSA; never fall back
+  // silently when that source is missing. Proof parsing validates its contents.
+  const verify = Boolean(env.TSA_CA_FILE || env.TSA_CA_PEM);
+  const pem = env.TSA_CA_FILE
+    ? await readCaFile(env.TSA_CA_FILE)
+    : env.TSA_CA_PEM?.replace(/\\n/g, '\n');
+  if (verify && (!pem?.trim() || typeof verifyResponse !== 'function')) {
+    throw new Error('Timestamp trust configuration is unavailable.');
+  }
+  const response = await fetchImpl(env.TSA_URL, {
+    method: 'POST', headers: { 'Content-Type': 'application/timestamp-query' }, body: query,
+  });
+  if (!response.ok) throw new Error(`TSA request failed with HTTP ${response.status}`);
+  const token = Buffer.from(await response.arrayBuffer());
+  if (verify) await verifyResponse({ token, query, pem });
+  return token;
+}
diff --git a/cloudflare/tsa-client.test.mjs b/cloudflare/tsa-client.test.mjs
new file mode 100644
index 0000000..ef27a76
--- /dev/null
+++ b/cloudflare/tsa-client.test.mjs
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createTimestampQuery, requestTimestamp } from './tsa-client.mjs';
+
+const rootHash = '01'.repeat(32);
+const token = Buffer.from('synthetic-timestamp-response');
+const response = { ok: true, arrayBuffer: async () => token };
+
+test('request carries the existing digest, a positive nonce and certReq', () => {
+  const query = createTimestampQuery(rootHash, Uint8Array.from([128, 1, 2, 3, 4, 5, 6, 7]));
+  assert.ok(query.includes(Buffer.from(rootHash, 'hex')));
+  assert.ok(query.includes(Buffer.from('0209008001020304050607', 'hex')));
+  assert.equal(query.subarray(-3).toString('hex'), '0101ff');
+});
+test('request rejects malformed digests before fetching', async () => {
+  for (const root of ['', 'gg'.repeat(32), 'ab'.repeat(31), null]) {
+    await assert.rejects(requestTimestamp(root, { env: { TSA_URL: 'https://tsa.invalid' },
+      fetchImpl: () => assert.fail('fetch must not run') }), /SHA-256/);
+  }
+});
+test('nonces are fresh and zero bytes are valid positive integers', () => {
+  assert.notDeepEqual(createTimestampQuery(rootHash), createTimestampQuery(rootHash));
+  assert.ok(createTimestampQuery(rootHash, new Uint8Array(8)).includes(Buffer.from('020100', 'hex')));
+  assert.throws(() => createTimestampQuery(rootHash, new Uint8Array(7)), /nonce/);
+});
+test('unverified mode preserves raw bytes and original HTTP contract', async () => {
+  const actual = await requestTimestamp(rootHash, { env: { TSA_URL: 'https://tsa.invalid' },
+    fetchImpl: async (url, options) => {
+      assert.equal(url, 'https://tsa.invalid'); assert.equal(options.method, 'POST');
+      assert.deepEqual(options.headers, { 'Content-Type': 'application/timestamp-query' });
+      assert.ok(options.body.includes(Buffer.from(rootHash, 'hex'))); return response;
+    }, verifyResponse: () => assert.fail('unverified mode must not claim verification') });
+  assert.deepEqual(actual, token);
+});
+test('escaped PEM reaches verifier and bytes are returned only after verification', async () => {
+  let verified = false;
+  const actual = await requestTimestamp(rootHash, { env: { TSA_URL: 'https://tsa.invalid', TSA_CA_PEM: 'CA\\nPEM' },
+    fetchImpl: async () => response, verifyResponse: async input => {
+      assert.equal(input.pem, 'CA\nPEM'); assert.deepEqual(input.token, token); verified = true;
+    } });
+  assert.ok(verified); assert.deepEqual(actual, token);
+});
+test('CA file takes precedence over PEM and read failure never falls back', async () => {
+  const env = { TSA_URL: 'https://tsa.invalid', TSA_CA_FILE: '/bundle/ca.pem', TSA_CA_PEM: 'ignored' };
+  await requestTimestamp(rootHash, { env, fetchImpl: async () => response,
+    readCaFile: async file => { assert.equal(file, '/bundle/ca.pem'); return 'FILE-CA'; },
+    verifyResponse: async ({ pem }) => assert.equal(pem, 'FILE-CA') });
+  await assert.rejects(requestTimestamp(rootHash, { env,
+    readCaFile: async () => { throw new Error('CA missing'); }, fetchImpl: () => assert.fail('must not fetch') }), /CA missing/);
+});
+test('missing verifier, empty trust and bad proof all fail closed', async () => {
+  const env = { TSA_URL: 'https://tsa.invalid', TSA_CA_PEM: 'CA' };
+  await assert.rejects(requestTimestamp(rootHash, { env, fetchImpl: () => assert.fail('must not fetch') }), /unavailable/);
+  await assert.rejects(requestTimestamp(rootHash, { env: { ...env, TSA_CA_PEM: ' ' },
+    verifyResponse: async () => {}, fetchImpl: () => assert.fail('must not fetch') }), /unavailable/);
+  await assert.rejects(requestTimestamp(rootHash, { env, fetchImpl: async () => response,
+    verifyResponse: async () => { throw new Error('untrusted proof'); } }), /untrusted proof/);
+});
+test('missing URL, fetch, network errors and HTTP failures remain errors', async () => {
+  await assert.rejects(requestTimestamp(rootHash, { env: {} }), /TSA_URL/);
+  const env = { TSA_URL: 'https://tsa.invalid' };
+  await assert.rejects(requestTimestamp(rootHash, { env, fetchImpl: null }), /fetch/);
+  await assert.rejects(requestTimestamp(rootHash, { env, fetchImpl: async () => { throw new Error('offline'); } }), /offline/);
+  await assert.rejects(requestTimestamp(rootHash, { env, fetchImpl: async () => ({ ok: false, status: 503 }) }), /503/);
+});
diff --git a/cloudflare/tsa-conformance.mjs b/cloudflare/tsa-conformance.mjs
new file mode 100644
index 0000000..e39a235
--- /dev/null
+++ b/cloudflare/tsa-conformance.mjs
@@ -0,0 +1,43 @@
+import { Buffer } from 'node:buffer';
+import * as asn1 from 'asn1js';
+import { TimeStampResp, SignedData } from 'pkijs';
+import { createTimestampQuery } from './tsa-client.mjs';
+import { verifyTimestampResponse } from './tsa-verify.mjs';
+
+export function timestampCases(fixtures) {
+  if (!fixtures.syntheticOnly) throw new Error('Synthetic fixtures required');
+  const query = Buffer.from(fixtures.queryBase64, 'base64');
+  const token = Buffer.from(fixtures.cases[0].responseBase64, 'base64');
+  const base = { query, token, pem: fixtures.trustedCaPem, now: new Date(fixtures.generatedAt) };
+  const cases = fixtures.cases.map(f => ({ name: 'accept OpenSSL ' + f.name,
+    run: () => verifyTimestampResponse({ ...base, token: Buffer.from(f.responseBase64, 'base64') }) }));
+  const reject = (name, change) => cases.push({ name, rejects: true, run: () => verifyTimestampResponse({ ...base, ...change }) });
+  reject('reject a different trusted CA', { pem: fixtures.untrustedCaPem });
+  reject('reject missing trust', { pem: '' });
+  reject('reject malformed trust', { pem: '-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----' });
+  reject('reject expired certificate path', { now: new Date('2099-01-01T00:00:00Z') });
+  const nonce = Uint8Array.from([128, 1, 2, 3, 4, 5, 6, 7]);
+  reject('reject different checkpoint digest', { query: createTimestampQuery('ff'.repeat(32), nonce) });
+  reject('reject replay against different nonce', { query: createTimestampQuery(fixtures.rootHash, new Uint8Array(8)) });
+  reject('reject TSA rejection status', { token: Buffer.from('30053003020102', 'hex') });
+  reject('reject truncated response', { token: token.subarray(0, token.length - 1) });
+  reject('reject trailing response bytes', { token: Buffer.concat([token, Buffer.from([0])]) });
+  const response = new TimeStampResp({ schema: asn1.fromBER(token).result });
+  const signed = new SignedData({ schema: response.timeStampToken.content });
+  signed.signerInfos[0].signature.valueBlock.valueHexView[0] ^= 1;
+  response.timeStampToken.content = signed.toSchema(true);
+  reject('reject modified signature', { token: Buffer.from(response.toSchema().toBER()) });
+  for (const fixture of fixtures.rejectedCases || []) reject(fixture.name, { token: Buffer.from(fixture.responseBase64, 'base64') });
+  return cases;
+}
+
+export async function runTimestampConformance(fixtures) {
+  const passed = [];
+  for (const scenario of timestampCases(fixtures)) {
+    let failed = false;
+    try { await scenario.run(); } catch (error) { if (!scenario.rejects) throw error; failed = true; }
+    if (Boolean(scenario.rejects) !== failed) throw new Error('Timestamp conformance failed: ' + scenario.name);
+    passed.push(scenario.name);
+  }
+  return { status: 'PASS_SYNTHETIC_CRYPTO_ONLY', passedCases: passed, liveTsaRequests: 0, productionRequests: 0 };
+}
