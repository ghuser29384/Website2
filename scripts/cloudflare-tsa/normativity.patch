+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFile } from 'node:fs/promises';
+import { timestampCases } from './tsa-conformance.mjs';
+
+const fixtures = JSON.parse(await readFile(new URL('./tsa-fixtures.json', import.meta.url), 'utf8'));
+for (const scenario of timestampCases(fixtures)) test(scenario.name, async () => {
+  if (scenario.rejects) await assert.rejects(scenario.run);
+  else await scenario.run();
+});
