+++ b/cloudflare/request-database.test.mjs
@@ -0,0 +1,51 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createRequestDatabase } from './request-database.mjs';
+
+function harness() {
+  const created = [], closed = [];
+  const scope = createRequestDatabase(url => {
+    const client = { url, read() { return this.url; }, async $disconnect() { closed.push(this.url); } };
+    created.push(client);
+    return client;
+  });
+  return { scope, created, closed };
+}
+
+test('does not create connections for requests that never use the database', async () => {
+  const h = harness();
+  await h.scope.run('', async () => assert.equal(h.scope.isDatabaseConfigured(), false));
+  assert.equal(h.created.length, 0);
+});
+test('database use outside a request fails closed', () => {
+  const h = harness();
+  assert.throws(() => h.scope.prisma.read(), /outside a request/);
+  assert.equal(h.created.length, 0);
+});
+test('missing configuration fails on use without constructing a client', async () => {
+  const h = harness();
+  await assert.rejects(h.scope.run('', async () => h.scope.prisma.read()), /not configured/);
+  assert.equal(h.created.length, 0);
+});
+test('overlapping requests retain separate clients and method receivers', async () => {
+  const h = harness();
+  let release; const gate = new Promise(resolve => { release = resolve; });
+  const a = h.scope.run('first', async () => {
+    assert.equal(h.scope.prisma.read(), 'first'); await gate;
+    assert.equal(h.scope.prisma.read(), 'first');
+  });
+  await h.scope.run('second', async () => assert.equal(h.scope.prisma.read(), 'second'));
+  release(); await a;
+  assert.deepEqual(h.closed, ['second', 'first']);
+  assert.equal(h.created.length, 2);
+});
+test('an operation failure still disconnects its client', async () => {
+  const h = harness();
+  await assert.rejects(h.scope.run('failure', async () => { h.scope.prisma.read(); throw new Error('synthetic'); }), /synthetic/);
+  assert.deepEqual(h.closed, ['failure']);
+});
+test('nested scopes fail rather than silently sharing the wrong connection', async () => {
+  const h = harness();
+  await assert.rejects(h.scope.run('outer', () => h.scope.run('inner', async () => {})), /Nested/);
+  assert.equal(h.created.length, 0);
+});
