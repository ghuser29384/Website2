// Synthetic compatibility candidate. Requires a pre-admitted checkpoint batch.
// This is not a replacement for checkpoint creation or the live scheduled route.
import {randomUUID} from 'node:crypto';
import {prisma} from '../../server/src/db/prisma';
import {timestampPendingCheckpoints} from '../../server/src/services/tsa';
import {verifyDispatch} from '../lib/audit-dispatch.mjs';
export const config={background:true};
export default async function timestampBackground(request: Request) {
 const payload=verifyDispatch(await request.text(),request.headers.get('x-audit-signature'),process.env.CRON_SECRET);
 const id=payload.job+':'+payload.nextRun;
 const state=await prisma.$queryRaw<any[]>`SELECT finished_at FROM synthetic_audit_dispatch.batch WHERE dispatch_id=${id}`;
 if(state.length!==1)throw new Error('Dispatch was not admitted');
 if(state[0].finished_at)return;
 if(!process.env.TSA_URL)throw new Error('Synthetic proof test requires TSA_URL');
 const worker=randomUUID();
 const claims=await prisma.$queryRaw<any[]>`SELECT synthetic_audit_dispatch.claim(${id},${worker}) AS generation`;
 const generation=claims[0].generation;
 if(generation===null)throw new Error('Dispatch already executing');
 try{
  const facade={auditCheckpoint:{findMany:async (_options:unknown)=>prisma.$queryRaw<any[]>`
   SELECT c.* FROM "AuditCheckpoint" c JOIN synthetic_audit_dispatch.batch b ON c.id=ANY(b.checkpoint_ids)
   WHERE b.dispatch_id=${id} AND NOT EXISTS(SELECT 1 FROM "AuditTimestamp" t WHERE t."checkpointId"=c.id)
   ORDER BY c."createdAt",c.id`},auditTimestamp:{create:async({data}:any)=>{
    const proofId=randomUUID();
    const result=await prisma.$queryRaw<any[]>`SELECT synthetic_audit_dispatch.save_proof(
     ${id},${worker},${generation}::bigint,${data.checkpointId},${proofId},${data.tsaUrl},
     ${Buffer.from(data.timestampTokenDer)}::bytea,${data.verifiedAt}::timestamp,${data.certificateFingerprint}::text) AS saved`;
    if(!result[0].saved)throw new Error('Proof was already stored');
    return data;
  }}};
  await timestampPendingCheckpoints(facade as any);
  const result=await prisma.$queryRaw<any[]>`SELECT synthetic_audit_dispatch.finish(${id},${worker},${generation}::bigint) AS finished`;
  if(!result[0].finished)throw new Error('Dispatch remains incomplete');
 }finally{
  await prisma.$queryRaw`SELECT synthetic_audit_dispatch.release(${id},${worker},${generation}::bigint)`;
 }
}
