@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFile } from 'node:fs/promises';
+import { derivePrismaSchema, bundleJoseImport, bundleAppEntrypoint } from './transforms.mjs';
+
+test('Workers generator preserves every database model and datasource byte', async () => {
+  const original = await readFile(new URL('../server/prisma/schema.prisma', import.meta.url), 'utf8');
+  const candidate = derivePrismaSchema(original);
+  const removeGenerator = s => s.replace(/generator client \{[^}]+\}/, '');
+  assert.equal(removeGenerator(candidate), removeGenerator(original));
+  assert.match(candidate, /engineType\s*= "client"/);
+  assert.match(candidate, /runtime\s*= "workerd"/);
+});
+for (const path of ['middleware/auth.ts', 'services/cryptoSigning.ts']) {
+  test('JOSE becomes statically bundleable without changing verification/signing: ' + path, async () => {
+    const source = await readFile(new URL('../server/src/' + path, import.meta.url), 'utf8');
+    const candidate = bundleJoseImport(source);
+    assert.equal(candidate.replace('return import("jose");', 'return new Function("specifier", "return import(specifier)")("jose");'), source);
+  });
+}
+test('the Workers bundle does not launch the standalone listener or interval', async () => {
+  const source = await readFile(new URL('../server/src/app.ts', import.meta.url), 'utf8');
+  const candidate = bundleAppEntrypoint(source);
+  assert.equal(candidate.replace('if (false) { // Not the standalone Node entrypoint.', 'if (require.main === module) {'), source);
+});
+test('source drift stops all build transformations', () => {
+  for (const transform of [derivePrismaSchema, bundleJoseImport, bundleAppEntrypoint]) assert.throws(() => transform(''), /review required/);
+});
