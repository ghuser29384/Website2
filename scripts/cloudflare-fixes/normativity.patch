+import { PrismaClient } from "./generated/client";
+import { PrismaPg } from "@prisma/adapter-pg";
+import { createRequestDatabase } from "./request-database.mjs";
+
+// Selected only by the Workers build alias. The Vercel singleton is untouched.
+const database = createRequestDatabase((connectionString: string) =>
+  new PrismaClient({ adapter: new PrismaPg({ connectionString }) }),
+);
+
+export const prisma = database.prisma as PrismaClient;
+export const isDatabaseConfigured = database.isDatabaseConfigured;
+export function withDatabase<T>(operation: () => Promise<T>): Promise<T> {
+  return database.run(process.env.DATABASE_URL, operation);
+}
