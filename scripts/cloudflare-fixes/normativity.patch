@@ -0,0 +1,26 @@
+import { createServer } from "node:http";
+import { httpServerHandler } from "cloudflare:node";
+import { createApp } from "../server/src/app";
+import publicConfig from "../api/public-config";
+import commitmentAudit from "../api/cron/commitment-audit";
+import { withDatabase } from "./prisma";
+
+// Backend compatibility harness only, not a deployable frontend migration.
+const app = createApp();
+app.all("/api/public-config", publicConfig);
+app.all("/api/cron/commitment-audit", commitmentAudit);
+
+const server = createServer((request, response) => {
+  void withDatabase(() => new Promise<void>((resolve, reject) => {
+    response.once("finish", resolve);
+    response.once("close", resolve);
+    response.once("error", reject);
+    app(request, response);
+  })).catch(() => {
+    // Do not expose connection strings, underlying errors or signing material.
+    if (!response.headersSent) response.writeHead(500, { "Content-Type": "application/json" });
+    if (!response.writableEnded) response.end('{"error":"Request failed."}');
+  });
+});
+server.listen(8080);
+export default httpServerHandler({ port: 8080 });
