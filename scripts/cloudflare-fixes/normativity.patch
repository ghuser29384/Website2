new file mode 100644
index 0000000..0677c13
--- /dev/null
+++ b/cloudflare/request-database.mjs
@@ -0,0 +1,33 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+// A Workers request must not reuse another request's sockets/client. Keep the
+// existing route/service API while binding its client to the current response.
+export function createRequestDatabase(createClient) {
+  const contexts = new AsyncLocalStorage();
+  const current = () => {
+    const context = contexts.getStore();
+    if (!context) throw new Error('Database access outside a request');
+    if (!context.connectionString) throw new Error('DATABASE_URL is not configured');
+    context.client ??= createClient(context.connectionString);
+    return context.client;
+  };
+  const prisma = new Proxy({}, {
+    get(_target, key) {
+      const client = current();
+      const value = Reflect.get(client, key, client);
+      return typeof value === 'function' ? value.bind(client) : value;
+    },
+  });
+  return {
+    prisma,
+    isDatabaseConfigured: () => Boolean(contexts.getStore()?.connectionString),
+    async run(connectionString, operation) {
+      if (contexts.getStore()) throw new Error('Nested database scope is unsupported');
+      const context = { connectionString, client: undefined };
+      return contexts.run(context, async () => {
+        try { return await operation(); }
+        finally { if (context.client) await context.client.$disconnect(); }
+      });
+    },
+  };
+}
diff --git a/cloudflare/request-database.test.mjs b/cloudflare/request-database.test.mjs
new file mode 100644
index 0000000..0154d4a
--- /dev/null
+++ b/cloudflare/request-database.test.mjs
@@ -0,0 +1,51 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createRequestDatabase } from './request-database.mjs';
+
+function harness() {
+  const created = [], closed = [];
+  const scope = createRequestDatabase(url => {
+    const client = { url, read() { return this.url; }, async $disconnect() { closed.push(this.url); } };
+    created.push(client);
+    return client;
+  });
+  return { scope, created, closed };
+}
+
+test('does not create connections for requests that never use the database', async () => {
+  const h = harness();
+  await h.scope.run('', async () => assert.equal(h.scope.isDatabaseConfigured(), false));
+  assert.equal(h.created.length, 0);
+});
+test('database use outside a request fails closed', () => {
+  const h = harness();
+  assert.throws(() => h.scope.prisma.read(), /outside a request/);
+  assert.equal(h.created.length, 0);
+});
+test('missing configuration fails on use without constructing a client', async () => {
+  const h = harness();
+  await assert.rejects(h.scope.run('', async () => h.scope.prisma.read()), /not configured/);
+  assert.equal(h.created.length, 0);
+});
+test('overlapping requests retain separate clients and method receivers', async () => {
+  const h = harness();
+  let release; const gate = new Promise(resolve => { release = resolve; });
+  const a = h.scope.run('first', async () => {
+    assert.equal(h.scope.prisma.read(), 'first'); await gate;
+    assert.equal(h.scope.prisma.read(), 'first');
+  });
+  await h.scope.run('second', async () => assert.equal(h.scope.prisma.read(), 'second'));
+  release(); await a;
+  assert.deepEqual(h.closed, ['second', 'first']);
+  assert.equal(h.created.length, 2);
+});
+test('an operation failure still disconnects its client', async () => {
+  const h = harness();
+  await assert.rejects(h.scope.run('failure', async () => { h.scope.prisma.read(); throw new Error('synthetic'); }), /synthetic/);
+  assert.deepEqual(h.closed, ['failure']);
+});
+test('nested scopes fail rather than silently sharing the wrong connection', async () => {
+  const h = harness();
+  await assert.rejects(h.scope.run('outer', () => h.scope.run('inner', async () => {})), /Nested/);
+  assert.equal(h.created.length, 0);
+});
diff --git a/cloudflare/transforms.mjs b/cloudflare/transforms.mjs
new file mode 100644
index 0000000..d88e6e1
--- /dev/null
+++ b/cloudflare/transforms.mjs
@@ -0,0 +1,24 @@
+// Build-only adaptations. Original Vercel source and database models stay intact.
+export function derivePrismaSchema(source) {
+  const original = 'generator client {\n  provider = "prisma-client-js"\n}';
+  if (source.split(original).length !== 2) throw new Error('Prisma generator changed; review required');
+  return source.replace(original, `generator client {
+  provider     = "prisma-client"
+  output       = "./generated"
+  engineType   = "client"
+  runtime      = "workerd"
+  moduleFormat = "esm"
+}`);
+}
+
+export function bundleJoseImport(source) {
+  const original = 'new Function("specifier", "return import(specifier)")("jose")';
+  if (source.split(original).length !== 2) throw new Error('JOSE import changed; review required');
+  return source.replace(original, 'import("jose")');
+}
+
+export function bundleAppEntrypoint(source) {
+  const original = 'if (require.main === module) {';
+  if (source.split(original).length !== 2) throw new Error('Server entrypoint changed; review required');
+  return source.replace(original, 'if (false) { // Not the standalone Node entrypoint.');
+}
