new file mode 100644
index 0000000..e727eb7
--- /dev/null
+++ b/cloudflare/auth-negative.test.mjs
@@ -0,0 +1,44 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+import { bundleJoseImport } from './transforms.mjs';
+
+// Execute the actual prepared auth middleware without installing Express/JOSE.
+// These negative cases never load JOSE; signed-token checks need the cloud run.
+const source = await readFile(new URL('../server/src/middleware/auth.ts', import.meta.url), 'utf8');
+const javascript = stripTypeScriptTypes(bundleJoseImport(source));
+const { requireAuth } = await import('data:text/javascript;base64,' + Buffer.from(javascript).toString('base64'));
+
+for (const [name, headers] of [
+  ['missing credentials', {}],
+  ['forged development administrator headers', { 'x-user-id': 'synthetic-admin', 'x-user-role': 'admin' }],
+  ['non-Bearer authorization', { authorization: 'Basic synthetic', 'x-user-id': 'synthetic-admin' }],
+]) {
+  test('production auth rejects ' + name, async () => {
+    const keys = ['NODE_ENV', 'ALLOW_DEVELOPMENT_AUTH_HEADERS'];
+    const previous = Object.fromEntries(keys.map(key => [key, process.env[key]]));
+    process.env.NODE_ENV = 'production';
+    process.env.ALLOW_DEVELOPMENT_AUTH_HEADERS = 'false';
+    try {
+      const result = await new Promise((resolve, reject) => {
+        const timeout = setTimeout(() => reject(new Error('Auth did not respond')), 1000);
+        const response = {
+          status(value) { this.code = value; return this; },
+          json(body) { clearTimeout(timeout); resolve({ code: this.code, body }); },
+        };
+        requireAuth({ header: key => headers[key] }, response, () => {
+          clearTimeout(timeout);
+          reject(new Error('Unauthorized request reached the route'));
+        });
+      });
+      assert.equal(result.code, 401);
+      assert.match(result.body.error, /Authentication required/);
+    } finally {
+      for (const key of keys) {
+        if (previous[key] === undefined) delete process.env[key];
+        else process.env[key] = previous[key];
+      }
+    }
+  });
+}
diff --git a/cloudflare/build.mjs b/cloudflare/build.mjs
