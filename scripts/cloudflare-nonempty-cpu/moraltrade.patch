@@ -0,0 +1,11 @@
+import handler from '../.open-next/worker.js';
+import { dispatchScheduled } from './scheduler.mjs';
+
+// Preserve any generated Durable Object exports as well as the HTTP handler.
+export * from '../.open-next/worker.js';
+export default {
+  fetch: handler.fetch,
+  async scheduled(controller, env, ctx) {
+    await dispatchScheduled(controller, env, request => handler.fetch(request, env, ctx));
+  },
+};
