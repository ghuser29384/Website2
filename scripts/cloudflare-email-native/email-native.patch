diff --git a/src/lib/email-outbox-client.ts b/src/lib/email-outbox-client.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/email-outbox-client.ts
@@ -0,0 +1,19 @@
+import { createServiceClient } from "@/lib/supabase/server";
+import { createNativeEmailOutbox, type EmailOutboxClient } from "./email-outbox-native";
+
+export async function createEmailOutboxClient(): Promise<EmailOutboxClient> {
+  const transport = process.env.EMAIL_OUTBOX_TRANSPORT;
+  if (!transport || transport === "rest") {
+    const client = createServiceClient() as any;
+    return { rpc: (name, args) => client.rpc(name, args), close: async () => {} };
+  }
+  if (transport !== "hyperdrive") throw new Error("Unknown email outbox transport.");
+
+  // Opt-in only. A missing binding must not silently replay work over another transport.
+  const { getCloudflareContext } = await import("@opennextjs/cloudflare");
+  const { env } = getCloudflareContext();
+  const binding = (env as unknown as { EMAIL_OUTBOX_DB?: { connectionString?: string } }).EMAIL_OUTBOX_DB;
+  if (!binding?.connectionString) throw new Error("Email database binding is missing.");
+  const { Client } = await import("pg");
+  return createNativeEmailOutbox(() => new Client({ connectionString: binding.connectionString }));
+}
diff --git a/src/lib/email-outbox-native.ts b/src/lib/email-outbox-native.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/email-outbox-native.ts
@@ -0,0 +1,80 @@
+// Email-only adapter: keep each existing RPC in its own autocommit transaction.
+// Never wrap the batch in BEGIN/COMMIT, cache receipts, or replay a failed query.
+export interface EmailQueryClient {
+  connect(): Promise<unknown>;
+  query(text: string, values: unknown[]): Promise<{ rows: Record<string, unknown>[] }>;
+  end(): Promise<unknown>;
+  on?(event: "error", listener: (error: unknown) => void): unknown;
+}
+
+export interface EmailOutboxClient {
+  rpc(name: string, args: Record<string, unknown>): PromiseLike<{
+    data: any;
+    error: { message: string } | null;
+  }>;
+  close(): Promise<void>;
+}
+
+const calls = {
+  claim_email_outbox_v2: {
+    text: "SELECT * FROM public.claim_email_outbox_v2($1::uuid, $2::integer)",
+    keys: ["p_worker_token", "p_limit"],
+    set: true,
+  },
+  complete_email_outbox_v2: {
+    text: "SELECT public.complete_email_outbox_v2($1::uuid, $2::uuid, $3::text) AS value",
+    keys: ["p_email_id", "p_worker_token", "p_provider_message_id"],
+    set: false,
+  },
+  retry_email_outbox_v2: {
+    text: "SELECT public.retry_email_outbox_v2($1::uuid, $2::uuid, $3::text) AS value",
+    keys: ["p_email_id", "p_worker_token", "p_error"],
+    set: false,
+  },
+  suppress_email_outbox_v2: {
+    text: "SELECT public.suppress_email_outbox_v2($1::uuid, $2::uuid, $3::text) AS value",
+    keys: ["p_email_id", "p_worker_token", "p_reason"],
+    set: false,
+  },
+} as const;
+
+export function createNativeEmailOutbox(factory: () => EmailQueryClient): EmailOutboxClient {
+  let current: EmailQueryClient | undefined;
+  let closed = false;
+  async function release(client: EmailQueryClient) {
+    if (current === client) current = undefined;
+    try { await client.end(); } catch { /* Do not replay acknowledged deliveries on cleanup failure. */ }
+  }
+  return {
+    async rpc(name, args) {
+      if (!Object.hasOwn(calls, name)) throw new Error("Unsupported email outbox operation.");
+      const call = calls[name as keyof typeof calls];
+      if (Object.keys(args).length !== call.keys.length || call.keys.some(key => !Object.hasOwn(args, key))) {
+        throw new Error("Invalid email outbox parameters.");
+      }
+      if (name === "claim_email_outbox_v2" && args.p_limit !== 25) {
+        throw new Error("The email batch must remain 25.");
+      }
+      if (closed) throw new Error("Email outbox client is closed.");
+      let client = current;
+      try {
+        if (!client) {
+          client = factory(); current = client;
+          const owned = client;
+          client.on?.("error", () => { void release(owned); });
+          await client.connect();
+        }
+        const result = await client.query(call.text, call.keys.map(key => args[key]));
+        return { data: call.set ? result.rows : result.rows[0]?.value ?? null, error: null };
+      } catch (error) {
+        if (client) await release(client);
+        // A subsequent retry RPC may reconnect, but this query is never replayed.
+        const serverError = error as { code?: string; message?: string };
+        const message = /^[0-9A-Z]{5}$/.test(serverError?.code ?? "") && serverError.message
+          ? serverError.message : "Email database connection failed.";
+        return { data: null, error: { message } };
+      }
+    },
+    async close() { closed = true; if (current) await release(current); },
+  };
+}
diff --git a/src/lib/email-outbox-native.test.ts b/src/lib/email-outbox-native.test.ts
