--- /dev/null
+++ b/src/lib/email-outbox-native.test.ts
@@ -0,0 +1,74 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createNativeEmailOutbox } from "./email-outbox-native";
+
+const token = "20000000-0000-4000-8000-000000000001";
+const claim = { p_worker_token: token, p_limit: 25 };
+const complete = { p_email_id: token, p_worker_token: token, p_provider_message_id: "synthetic-message" };
+function fixture(options: { failQuery?: number; failConnect?: boolean; failClose?: boolean } = {}) {
+  const seen: { text: string; values: unknown[] }[] = [];
+  const clients: any[] = []; let queries = 0;
+  const outbox = createNativeEmailOutbox(() => {
+    const client = {
+      connected: 0, ended: 0, idleError: (_error: unknown) => {},
+      async connect() { client.connected++; if (options.failConnect) throw new Error("private connection string"); },
+      async query(text: string, values: unknown[]) {
+        seen.push({ text, values }); queries++;
+        if (queries === options.failQuery) throw Object.assign(new Error("Synthetic SQL failure"), { code: "23514" });
+        return { rows: text.includes("claim_") ? [{ id: token }] : [{ value: text.includes("retry_") ? "retry" : true }] };
+      },
+      async end() { client.ended++; if (options.failClose) throw new Error("private close error"); },
+      on(_event: "error", callback: (error: unknown) => void) { client.idleError = callback; },
+    };
+    clients.push(client); return client;
+  });
+  return { outbox, seen, clients };
+}
+test("full 25-email batch retains 26 independent queries on one request-owned client", async () => {
+  const f = fixture(); await f.outbox.rpc("claim_email_outbox_v2", claim);
+  for (let i = 0; i < 25; i++) await f.outbox.rpc("complete_email_outbox_v2", complete);
+  await f.outbox.close(); assert.equal(f.seen.length, 26); assert.equal(f.clients.length, 1);
+  assert.equal(f.clients[0].connected, 1); assert.equal(f.clients[0].ended, 1);
+  for (const { text } of f.seen) assert.doesNotMatch(text, /\b(begin|commit|rollback|set|insert|update)\b/i);
+});
+test("all four operations preserve parameter order and scalar/set results", async () => {
+  const f = fixture();
+  assert.deepEqual((await f.outbox.rpc("claim_email_outbox_v2", claim)).data, [{ id: token }]);
+  assert.equal((await f.outbox.rpc("complete_email_outbox_v2", complete)).data, true);
+  assert.equal((await f.outbox.rpc("retry_email_outbox_v2", { p_error: "failure", p_worker_token: token, p_email_id: token })).data, "retry");
+  assert.equal((await f.outbox.rpc("suppress_email_outbox_v2", { p_reason: "unsafe", p_worker_token: token, p_email_id: token })).data, true);
+  assert.deepEqual(f.seen.map(x => x.values), [[token,25],[token,token,"synthetic-message"],[token,token,"failure"],[token,token,"unsafe"]]);
+  await f.outbox.close();
+});
+test("message content is bound as data, never interpolated into SQL", async () => {
+  const f = fixture(), message = "'); DELETE FROM email_outbox; --";
+  await f.outbox.rpc("retry_email_outbox_v2", { p_email_id:token,p_worker_token:token,p_error:message });
+  assert.equal(f.seen[0].values[2], message); assert.ok(!f.seen[0].text.includes(message)); await f.outbox.close();
+});
+test("failed completion is not replayed; the existing retry RPC reconnects independently", async () => {
+  const f = fixture({ failQuery:2 }); await f.outbox.rpc("claim_email_outbox_v2", claim);
+  assert.equal((await f.outbox.rpc("complete_email_outbox_v2", complete)).error?.message, "Synthetic SQL failure");
+  assert.equal(f.seen.length, 2); assert.equal(f.clients[0].ended, 1);
+  assert.equal((await f.outbox.rpc("retry_email_outbox_v2", { p_email_id:token,p_worker_token:token,p_error:"Synthetic SQL failure" })).data, "retry");
+  assert.equal(f.clients.length, 2); assert.equal(f.seen.length, 3); await f.outbox.close();
+});
+test("connection errors expose no connection string and cause no SQL replay", async () => {
+  const f = fixture({ failConnect:true }); const r = await f.outbox.rpc("claim_email_outbox_v2", claim);
+  assert.equal(r.error?.message, "Email database connection failed."); assert.equal(f.seen.length, 0); await f.outbox.close();
+});
+test("unknown operations, missing/extra arguments and changed batch sizes fail before connection", async () => {
+  const f = fixture();
+  for (const [name,args] of [["constructor",claim],["other",claim],["claim_email_outbox_v2",{...claim,p_limit:24}],["claim_email_outbox_v2",{...claim,extra:1}],["complete_email_outbox_v2",{p_email_id:token}]] as const) await assert.rejects(async () => f.outbox.rpc(name,args));
+  assert.equal(f.clients.length, 0); await f.outbox.close();
+});
+test("idle failure discards only its client; later operations reconnect without replay", async () => {
+  const f = fixture(); await f.outbox.rpc("claim_email_outbox_v2",claim);
+  f.clients[0].idleError(new Error("synthetic idle failure"));
+  await f.outbox.rpc("complete_email_outbox_v2",complete);
+  assert.equal(f.clients.length, 2); assert.equal(f.seen.length, 2); await f.outbox.close();
+});
+test("cleanup failure does not turn a committed delivery into a retry", async () => {
+  const f = fixture({failClose:true}); assert.equal((await f.outbox.rpc("complete_email_outbox_v2",complete)).data,true);
+  await f.outbox.close(); assert.equal(f.seen.length,1);
+  await assert.rejects(async () => f.outbox.rpc("claim_email_outbox_v2",claim));
+});
