diff --git a/scripts/render-commitments-impact-methodologies-qa-sql.mjs b/scripts/render-commitments-impact-methodologies-qa-sql.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/render-commitments-impact-methodologies-qa-sql.mjs
@@ -0,0 +1,130 @@
+import fs from "node:fs";
+import path from "node:path";
+
+const manifestPath = "docs/commitments/impact-methodologies-v1/manifest.json";
+const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
+const manifestDir = path.dirname(manifestPath);
+const commitRequested = process.argv.includes("--commit");
+
+if (commitRequested && process.env.COMMITMENTS_IMPACT_QA_STAGE_CONFIRM !== "hvmxfjjbdcgjjudmthdz") {
+  throw new Error(
+    "Persistent staging is QA-only and requires COMMITMENTS_IMPACT_QA_STAGE_CONFIRM=hvmxfjjbdcgjjudmthdz.",
+  );
+}
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+function sqlLiteral(value) {
+  return `'${String(value).replaceAll("'", "''")}'`;
+}
+
+function sqlTextArray(values) {
+  return `array[${values.map(sqlLiteral).join(",")}]::text[]`;
+}
+
+assert(
+  manifest.bundleSchemaVersion === "moral-trade-impact-methodology-bundle-v1",
+  "Unexpected methodology bundle schema.",
+);
+assert(Array.isArray(manifest.methodologies) && manifest.methodologies.length === 6, "Expected six candidates.");
+
+const rows = manifest.methodologies.map((entry) => {
+  const wrapper = JSON.parse(fs.readFileSync(path.join(manifestDir, entry.methodologyFile), "utf8"));
+  assert(entry.lifecycleStatus === "draft", `${entry.mechanismFamily} manifest row must be draft.`);
+  assert(wrapper.lifecycleStatus === "draft", `${entry.mechanismFamily} wrapper must be draft.`);
+  assert(Array.isArray(entry.approvalBlockers) && entry.approvalBlockers.length > 0, "Manifest blockers required.");
+  assert(
+    JSON.stringify(entry.approvalBlockers) === JSON.stringify(wrapper.approvalBlockers),
+    `${entry.mechanismFamily} blocker drift.`,
+  );
+  assert(wrapper.methodologyHash === entry.methodologyHash, `${entry.mechanismFamily} hash drift.`);
+  assert(wrapper.methodology.mechanismFamily === entry.mechanismFamily, `${entry.mechanismFamily} family drift.`);
+  assert(wrapper.methodology.modelKey === entry.modelKey, `${entry.mechanismFamily} model-key drift.`);
+  return {
+    mechanismFamily: entry.mechanismFamily,
+    modelKey: entry.modelKey,
+    version: entry.version,
+    methodologyHash: entry.methodologyHash,
+    approvalBlockers: entry.approvalBlockers,
+    methodology: wrapper.methodology,
+  };
+});
+
+const lines = [
+  "\\set ON_ERROR_STOP on",
+  "begin;",
+  "",
+];
+
+for (const row of rows) {
+  const methodologyJson = JSON.stringify(row.methodology);
+  lines.push(
+    "insert into public.impact_model_versions (",
+    "  mechanism_family, model_key, version, lifecycle_status, methodology, methodology_hash, approval_blockers",
+    ")",
+    "select",
+    `  ${sqlLiteral(row.mechanismFamily)},`,
+    `  ${sqlLiteral(row.modelKey)},`,
+    `  ${row.version},`,
+    "  'draft',",
+    `  ${sqlLiteral(methodologyJson)}::jsonb,`,
+    `  ${sqlLiteral(row.methodologyHash)},`,
+    `  ${sqlTextArray(row.approvalBlockers)}`,
+    "where not exists (",
+    "  select 1 from public.impact_model_versions",
+    `  where model_key = ${sqlLiteral(row.modelKey)} and version = ${row.version}`,
+    ");",
+    "",
+  );
+}
+
+lines.push(
+  "do $verify$",
+  "declare",
+  "  expected_count integer := 0;",
+  "begin",
+);
+
+for (const row of rows) {
+  const methodologyJson = JSON.stringify(row.methodology);
+  lines.push(
+    "  if 1 <> (",
+    "    select count(*)",
+    "    from public.impact_model_versions",
+    `    where mechanism_family = ${sqlLiteral(row.mechanismFamily)}`,
+    `      and model_key = ${sqlLiteral(row.modelKey)}`,
+    `      and version = ${row.version}`,
+    "      and lifecycle_status = 'draft'",
+    `      and methodology = ${sqlLiteral(methodologyJson)}::jsonb`,
+    `      and methodology_hash = ${sqlLiteral(row.methodologyHash)}`,
+    `      and approval_blockers = ${sqlTextArray(row.approvalBlockers)}`,
+    "      and submitted_at is null",
+    "      and approved_at is null",
+    "      and activated_at is null",
+    "  ) then",
+    `    raise exception 'Exact draft methodology candidate missing or drifted: ${row.modelKey}';`,
+    "  end if;",
+    "  expected_count := expected_count + 1;",
+    "",
+  );
+}
+
+lines.push(
+  "  if expected_count <> 6 then",
+  "    raise exception 'Expected six exact draft methodology candidates';",
+  "  end if;",
+  "end",
+  "$verify$;",
+  "",
+  "select mechanism_family, model_key, version, lifecycle_status, methodology_hash, cardinality(approval_blockers) as blocker_count",
+  "from public.impact_model_versions",
+  `where model_key in (${rows.map((row) => sqlLiteral(row.modelKey)).join(",")})`,
+  "order by mechanism_family;",
+  "",
+  commitRequested ? "commit;" : "rollback;",
+  "",
+);
+
+process.stdout.write(lines.join("\n"));
