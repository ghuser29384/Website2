NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Preferred for private matching text. Use a random 32-byte value such as base64:<value>.
# When omitted, the server derives a domain-separated encrypted-storage fallback from the
# server-only Supabase service-role key so profile saves remain encrypted and available.
BACKGROUND_FIELD_ENCRYPTION_KEY=
# For rotation, configure BACKGROUND_FIELD_ENCRYPTION_KEYS plus
# BACKGROUND_FIELD_ENCRYPTION_ACTIVE_KEY_ID instead of the single key above.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google and Apple OAuth client secrets are configured in Supabase Auth provider settings.
# Add NEXT_PUBLIC_SITE_URL/auth/confirm as an allowed Supabase redirect URL for each deployment.
# To enable hosted Supabase OAuth through the Management API, run
# npm run auth:configure-oauth with SUPABASE_ACCESS_TOKEN plus:
# GOOGLE_OAUTH_CLIENT_ID=... and GOOGLE_OAUTH_CLIENT_SECRET=...
# APPLE_OAUTH_CLIENT_ID=org.moraltrade.web and APPLE_OAUTH_CLIENT_SECRET=...
# Optional read-only X profile source. Keep disabled until an approved X Web App is configured.
# The callback must match the X Developer Console value exactly.
X_PROFILE_CONNECTOR_ENABLED=false
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe-hosted Checkout uses Dashboard-managed dynamic payment methods. Keep cards and
# Link enabled; Apple Pay and Google Pay appear as eligible card wallets. PayPal requires
# an eligible Stripe account region and Stripe approval for Connect marketplace use.
STRIPE_PLATFORM_ACCOUNT_ID=acct_1TLqUmAf75xWktVp
STRIPE_PLATFORM_FEE_BPS=0
# Keep disabled in production until all live gates pass. Test mode is restricted to local and
# preview deployments with Stripe test keys, a signed test webhook, and non-production data.
CONDITIONAL_PAYMENTS_MODE=disabled
# Moral Trade project funding defaults to direct-to-charity routes only. Change to
# fiscal_sponsor only after a signed sponsorship agreement and all public disclosures exist.
MORAL_TRADE_FUNDING_MODE=external_charities_only
FISCAL_SPONSOR_LEGAL_NAME=
FISCAL_SPONSOR_JURISDICTION=
FISCAL_SPONSOR_CONTRIBUTION_URL=
FISCAL_SPONSOR_FEE_DISCLOSURE=
FISCAL_SPONSOR_TAX_RECEIPT_DISCLOSURE=
FISCAL_SPONSOR_REFUND_POLICY_URL=
MPGF_REAL_MONEY_ENABLED=false
MPGF_REAL_MONEY_ACCEPTANCE_ENABLED=false
MPGF_TEST_PAYMENT_ENABLED=false
MPGF_MANUAL_EVIDENCE_PROVIDER_LABEL=Open Collective
NEXT_PUBLIC_MPGF_EXTERNAL_PAYMENT_URL=
# Every.org pledge-donation connector. Keep disabled until the staging webhook has been
# verified end to end. The path and metadata secrets must each be at least 32 random characters.
EVERY_ORG_PLEDGE_DONATIONS_ENABLED=false
EVERY_ORG_ENVIRONMENT=staging
EVERY_ORG_WEBHOOK_TOKEN=
EVERY_ORG_WEBHOOK_PATH_SECRET=
EVERY_ORG_PARTNER_METADATA_SECRET=
# Direct, non-custodial Donation Upgrade rail. Each participant donates directly on
# Every.org after the branch is fixed; Moral Trade never holds the donation. Staging
# may use the two deterministic QA fixtures when the public API key is unavailable.
DIRECT_DONATION_UPGRADES_ENABLED=false
DIRECT_DONATION_UPGRADE_MODE=disabled
DIRECT_DONATION_UPGRADE_QA_FIXTURES=false
EVERY_ORG_PUBLIC_API_KEY=
# Organization autocomplete always uses ProPublica/IRS, Wikidata, and the keyless ROR API.
# ROR client IDs are free, non-secret identifiers used only for rate-limit differentiation.
# Registration is currently paused and no separate identified/unidentified limits are enforced.
ROR_API_CLIENT_ID=
# OpenAlex requires a free API key for dependable institutions/funders search. When omitted,
# Moral Trade skips OpenAlex while retaining the three always-on registries above.
OPENALEX_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
ADMIN_EMAILS=
BACKGROUND_NETWORKING_ROLLOUT_STAGE=internal
BACKGROUND_SOURCE_SUMMARY_ENABLED=false
BACKGROUND_WISH_INTERVIEW_ENABLED=false
BACKGROUND_OPPORTUNITY_BRIEFS_ENABLED=false
# Deterministic extraction and controlled semantic matching always run. Vercel production
# enables the ambiguity-only LLM fallback automatically when a server-side OpenAI key is
# configured. Set this opt-in flag to true for preview or local environments. The separate
# disable override stops the fallback in every environment.
AI_QUERY_FALLBACK_ENABLED=false
AI_QUERY_FALLBACK_KILL_SWITCH=false
OPENAI_API_KEY=
OPENAI_QUERY_MODEL=gpt-5-nano
OPENAI_QUERY_TIMEOUT_MS=12000
# Reciprocal-feed embeddings have a strict public-data boundary: only published opportunity
# text and fixed public cause/action concepts are sent to the provider. Private profile prose is
# mapped locally to those concepts and is never embedded externally.
LIVE_FEED_EMBEDDINGS_ENABLED=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional reduced dimension supported by text-embedding-3 models. Leave blank for model default.
OPENAI_EMBEDDING_DIMENSIONS=
OPENAI_EMBEDDING_TIMEOUT_MS=6500
# Maximum public candidates considered by one semantic retrieval batch (bounded to 60-800).
LIVE_FEED_RETRIEVAL_POOL_SIZE=360

# Local, auditable opportunity synthesis. Set false as an immediate kill switch.
OPPORTUNITY_SYNTHESIS_ENABLED=true
