{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPGF Status Value Registry",
  "type": "object",
  "required": ["version", "values"],
  "properties": {
    "values": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          {
            "type": "object",
            "required": ["allowedValues", "owner", "conformanceRows", "acceptanceCriteria"],
            "properties": {
              "allowedValues": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "owner": { "type": "string" },
              "conformanceRows": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "acceptanceCriteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
