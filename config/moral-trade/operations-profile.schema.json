{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.moraltrade.org/schemas/moral-trade/operations-profile.schema.json",
  "title": "Moral Trade Operations Profile",
  "type": "object",
  "required": [
    "version",
    "purpose",
    "securityHeaders",
    "rateLimitSurfaces",
    "privacyAndSessionControls",
    "observabilityMetrics",
    "fallbackControls",
    "rolloutGates",
    "operationalTests"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "securityHeaders": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["code", "label", "evidence"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "rateLimitSurfaces": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["key", "window", "limit"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "window": { "type": "string", "minLength": 1 },
          "limit": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "privacyAndSessionControls": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["key", "label", "evidence"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "observabilityMetrics": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "fallbackControls": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["key", "label", "rule"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "rolloutGates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["key", "label", "rule"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "operationalTests": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
