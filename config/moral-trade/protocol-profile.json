{
  "version": "moral-trade-core-v0.1.2-2026-05",
  "purpose": "Public contract for core Moral Trade proposal review, matching explanations, evidence states, and provenance.",
  "requiredProposalFields": [
    { "key": "format", "label": "Trade format" },
    { "key": "cause_areas", "label": "Offered and requested cause areas" },
    { "key": "offered_action", "label": "Offered action" },
    { "key": "requested_action", "label": "Requested action" },
    { "key": "baseline_statement", "label": "No-trade baseline" },
    { "key": "duration", "label": "Duration or review period" },
    { "key": "exit_conditions", "label": "Exit, pause, expiry, or unresolved-evidence rule" },
    { "key": "verification_method", "label": "Verification method" },
    { "key": "public_description", "label": "Public description and boundaries" }
  ],
  "statusValues": [
    "draft",
    "submitted",
    "needs_clarification",
    "needs_evidence",
    "needs_human_review",
    "challenge_window",
    "completion_reviewed",
    "disputed_unresolved",
    "blocked",
    "matchable"
  ],
  "stateTransitionRules": [
    {
      "key": "draft_intake",
      "from": "draft",
      "allowedTo": ["needs_clarification", "submitted", "blocked"],
      "requires": ["required_fields_before_submitted", "policy_screen_before_blocked", "transition_event_recorded"],
      "provenanceActivity": "draft_created"
    },
    {
      "key": "clarification_resubmission",
      "from": "needs_clarification",
      "allowedTo": ["draft", "submitted", "blocked"],
      "requires": ["required_fields_before_submitted", "transition_event_recorded"],
      "provenanceActivity": "draft_updated"
    },
    {
      "key": "submitted_triage",
      "from": "submitted",
      "allowedTo": ["needs_evidence", "needs_human_review", "challenge_window", "matchable", "blocked"],
      "requires": ["required_fields_before_reliance", "policy_screen_before_matchable", "baseline_credibility_before_matchable", "evidence_sufficiency_before_matchable", "externality_trigger_before_matchable", "privacy_redaction_before_matchable", "match_explanation_before_matchable", "human_review_before_matchable", "transition_event_recorded"],
      "provenanceActivity": "risk_screened"
    },
    {
      "key": "evidence_review",
      "from": "needs_evidence",
      "allowedTo": ["submitted", "needs_human_review", "challenge_window", "blocked"],
      "requires": ["evidence_metadata_reviewed", "transition_event_recorded"],
      "provenanceActivity": "evidence_submitted"
    },
    {
      "key": "human_review_routing",
      "from": "needs_human_review",
      "allowedTo": ["needs_evidence", "challenge_window", "matchable", "blocked"],
      "requires": ["policy_screen_before_matchable", "baseline_credibility_before_matchable", "evidence_sufficiency_before_matchable", "externality_trigger_before_matchable", "privacy_redaction_before_matchable", "match_explanation_before_matchable", "human_review_before_matchable", "transition_event_recorded"],
      "provenanceActivity": "risk_screened"
    },
    {
      "key": "challenge_window_resolution",
      "from": "challenge_window",
      "allowedTo": ["needs_evidence", "completion_reviewed", "disputed_unresolved", "blocked"],
      "requires": ["evidence_metadata_reviewed", "human_review_before_completion", "transition_event_recorded"],
      "provenanceActivity": "challenge_window_opened"
    },
    {
      "key": "dispute_resolution",
      "from": "disputed_unresolved",
      "allowedTo": ["challenge_window", "completion_reviewed", "blocked"],
      "requires": ["dispute_record_before_unresolved", "human_review_before_completion", "transition_event_recorded"],
      "provenanceActivity": "review_completed"
    },
    {
      "key": "match_recheck",
      "from": "matchable",
      "allowedTo": ["needs_evidence", "challenge_window", "blocked"],
      "requires": ["transition_event_recorded"],
      "provenanceActivity": "risk_screened"
    },
    {
      "key": "completion_challenge",
      "from": "completion_reviewed",
      "allowedTo": ["disputed_unresolved", "blocked"],
      "requires": ["dispute_record_before_unresolved", "transition_event_recorded"],
      "provenanceActivity": "review_completed"
    }
  ],
  "guardrails": [
    {
      "code": "no_global_moral_ranking",
      "label": "No global moral ranking",
      "rule": "Scores are participant-relative and must not be described as Moral Trade's objective moral valuation."
    },
    {
      "code": "anti_threat_baseline",
      "label": "Anti-threat baseline",
      "rule": "Block threats, coercion, harassment, doxxing, fraud, newly escalated harmful behavior, and pay-me-or-I-will-X framing."
    },
    {
      "code": "no_autonomous_outreach",
      "label": "No autonomous outreach",
      "rule": "Matching can draft explanations and introduction plans but must not contact counterparties without consent."
    },
    {
      "code": "privacy_redaction_required",
      "label": "Privacy redaction required",
      "rule": "Exact wishes, identity details, contact data, and sensitive constraints remain hidden until the proper disclosure stage."
    },
    {
      "code": "separate_trust_axes",
      "label": "Separate trust axes",
      "rule": "Factual evidence, counterfactual baseline confidence, and externality review must remain distinct."
    }
  ],
  "factorCodes": [
    {
      "code": "terms_complete",
      "label": "Terms complete",
      "description": "The action, reciprocal request, duration, exit rule, and verification method are present."
    },
    {
      "code": "baseline_stated",
      "label": "Baseline stated",
      "description": "The no-trade default is explicit enough for counterfactual review."
    },
    {
      "code": "baseline_credibility",
      "label": "Baseline credibility",
      "description": "The no-trade default includes prior intent, history, dated support, or another reviewable counterfactual basis."
    },
    {
      "code": "baseline_challenge_recommended",
      "label": "Baseline challenge recommended",
      "description": "The baseline is stated but thin enough that reviewers should request prior-intent or past-behavior support before reliance."
    },
    {
      "code": "evidence_rule_named",
      "label": "Evidence rule named",
      "description": "The draft names the receipt, log, attestation, provider record, audit, or manual review path."
    },
    {
      "code": "participant_relative_scores",
      "label": "Participant-relative scores",
      "description": "Importance scores are treated as user-stated thresholds, not platform rankings."
    },
    {
      "code": "party_relative_benefit",
      "label": "Party-relative benefit",
      "description": "The draft explains why each side is better off than the no-trade baseline using participant-relative priorities."
    },
    {
      "code": "externality_review_required",
      "label": "Externality review required",
      "description": "The draft may affect unrepresented people, political-adjacent claims, incentives, or vulnerable parties."
    },
    {
      "code": "privacy_safe_preview",
      "label": "Privacy-safe preview",
      "description": "Match explanations can use broad cause areas, format, verification preferences, and redaction notes."
    },
    {
      "code": "human_review_required",
      "label": "Human review required",
      "description": "A reviewer must inspect safety, evidence, baseline, externality, or disclosure concerns before reliance."
    },
    {
      "code": "cause_area_overlap",
      "label": "Cause-area overlap",
      "description": "A redacted match signal found broad cause-area overlap without exposing exact wishes or private text."
    },
    {
      "code": "cause_area_complementarity",
      "label": "Cause-area complementarity",
      "description": "One side's broad offered cause area can satisfy the other side's broad requested cause area without exposing exact wishes."
    },
    {
      "code": "trade_mode_compatible",
      "label": "Trade-mode compatible",
      "description": "Both redacted profiles support at least one compatible trade format."
    },
    {
      "code": "verification_preference_compatible",
      "label": "Verification preference compatible",
      "description": "Both redacted profiles support at least one compatible evidence or verification preference."
    },
    {
      "code": "location_constraint_satisfied",
      "label": "Location constraint satisfied",
      "description": "Any declared city or region sensitivity is satisfied at a coarse, privacy-safe level."
    },
    {
      "code": "privacy_stage_compatible",
      "label": "Privacy stage compatible",
      "description": "Both sides are still inside the same consent-gated disclosure stage."
    },
    {
      "code": "stated_exclusions_clear",
      "label": "Stated exclusions clear",
      "description": "The redacted match signal did not find a conflict with either side's stated exclusions."
    }
  ],
  "evidenceSchemas": [
    {
      "key": "pledge_swap_v1",
      "label": "Pledge swap evidence",
      "required": ["dated pledge", "review period", "check-in rule", "no-trade baseline"]
    },
    {
      "key": "donation_offset_v1",
      "label": "Donation offset evidence",
      "required": ["baseline donation claim", "compromise destination", "match ratio", "unmatched surplus rule", "receipt or audit path"]
    },
    {
      "key": "paid_action_v1",
      "label": "Paid action evidence",
      "required": ["external payment record", "action log or attestation", "counterfactual baseline", "dispute route"]
    },
    {
      "key": "public_good_commitment_v1",
      "label": "Public-good commitment evidence",
      "required": ["threshold rule", "recipient or implementation record", "external contribution evidence", "reviewed completion state"]
    }
  ],
  "provenanceModel": {
    "entities": ["proposal_record", "offer", "evidence_artifact", "external_entity_reference", "review_decision", "match_explanation", "match_signal", "traceability_event"],
    "activities": ["draft_created", "draft_updated", "evidence_submitted", "traceability_event_recorded", "risk_screened", "challenge_window_opened", "review_completed"],
    "agents": ["participant", "counterparty", "operator", "external_reviewer", "payment_or_evidence_provider"]
  },
  "provenanceObjectSchemas": [
    {
      "key": "evidence_artifact",
      "label": "Evidence artifact entity",
      "required": ["id", "kind", "normalizedLocator", "mediaType", "claimScopes", "submittedAt", "submittedByAgentId", "redactionLevel", "sha256"]
    },
    {
      "key": "evidence_claim",
      "label": "Evidence claim",
      "required": ["id", "proposalId", "claimType", "artifactIds", "claimScope", "reviewerConfidence", "uniquenessChecked"]
    },
    {
      "key": "external_entity_reference",
      "label": "External entity reference",
      "required": ["id", "entityType", "label", "identifierSystem", "normalizedIdentifier", "dedupeKey", "verificationStatus", "redactionLevel", "sha256"]
    },
    {
      "key": "review_decision",
      "label": "Reviewer decision",
      "required": ["id", "proposalId", "outcome", "reasonCodes", "summary", "reviewerId", "createdAt"]
    },
    {
      "key": "match_signal",
      "label": "Privacy-safe match signal",
      "required": ["id", "leftProfileId", "rightProfileId", "status", "factorCodes", "confidenceBand", "redactedFields", "humanReviewRequired", "createdAt"]
    },
    {
      "key": "traceability_event",
      "label": "Interoperable traceability event",
      "required": ["id", "eventTime", "recordedAt", "action", "businessStep", "disposition", "what", "where", "why", "agentIds", "redactionLevel", "sha256"]
    },
    {
      "key": "state_transition_event_record",
      "label": "Immutable state transition event record",
      "required": ["id", "schemaVersion", "subjectId", "subjectKind", "from", "to", "provenanceActivity", "recordedAt", "actorAgentId", "actorAgentKind", "usedEntityIds", "generatedEntityIds", "idempotencyKey", "previousEventHash", "eventHash"]
    },
    {
      "key": "provenance_activity",
      "label": "Provenance activity",
      "required": ["id", "kind", "at", "usedEntityIds", "generatedEntityIds", "agentIds"]
    },
    {
      "key": "provenance_agent",
      "label": "Provenance agent",
      "required": ["id", "kind", "label"]
    }
  ],
  "provenancePersistence": {
    "strategy": "Append-only owner-scoped tables persist W3C PROV-style entities, activities, agents, external references, and EPCIS-oriented traceability events. Public reads require redaction_level=public; private artifacts remain owner-scoped unless a separate review workflow publishes a redacted summary.",
    "tables": [
      {
        "table": "moral_trade_provenance_agents",
        "objectSchemaKey": "provenance_agent",
        "accessModel": "owner_insert_public_or_owner_read",
        "requiredColumns": ["id", "owner_profile_id", "agent_key", "kind", "label", "redaction_level", "created_at"]
      },
      {
        "table": "moral_trade_evidence_artifacts",
        "objectSchemaKey": "evidence_artifact",
        "accessModel": "owner_insert_public_or_owner_read",
        "requiredColumns": ["id", "owner_profile_id", "subject_kind", "subject_id", "kind", "normalized_locator", "claim_scopes", "submitted_by_agent_id", "redaction_level", "sha256"]
      },
      {
        "table": "moral_trade_evidence_claims",
        "objectSchemaKey": "evidence_claim",
        "accessModel": "owner_insert_public_or_owner_read",
        "requiredColumns": ["id", "owner_profile_id", "subject_kind", "subject_id", "claim_type", "claim_scope", "reviewer_confidence", "uniqueness_checked", "redaction_level"]
      },
      {
        "table": "moral_trade_evidence_claim_artifacts",
        "objectSchemaKey": "evidence_claim",
        "accessModel": "owner_insert_public_pair_read",
        "requiredColumns": ["claim_id", "artifact_id", "owner_profile_id", "created_at"]
      },
      {
        "table": "moral_trade_external_entity_references",
        "objectSchemaKey": "external_entity_reference",
        "accessModel": "owner_insert_public_or_owner_read",
        "requiredColumns": ["id", "owner_profile_id", "entity_type", "identifier_system", "normalized_identifier", "dedupe_key", "verification_status", "redaction_level", "sha256"]
      },
      {
        "table": "moral_trade_review_decisions",
        "objectSchemaKey": "review_decision",
        "accessModel": "owner_insert_public_or_owner_read",
        "requiredColumns": ["id", "owner_profile_id", "subject_kind", "subject_id", "outcome", "reason_codes", "summary", "reviewer_agent_id", "redaction_level"]
      },
      {
        "table": "moral_trade_provenance_activities",
        "objectSchemaKey": "provenance_activity",
        "accessModel": "owner_insert_public_or_owner_read",
        "requiredColumns": ["id", "owner_profile_id", "subject_kind", "subject_id", "kind", "activity_at", "used_entity_ids", "generated_entity_ids", "agent_ids", "activity_hash"]
      },
      {
        "table": "moral_trade_traceability_events",
        "objectSchemaKey": "traceability_event",
        "accessModel": "owner_insert_public_or_owner_read",
        "requiredColumns": ["id", "owner_profile_id", "event_time", "recorded_at", "action", "business_step", "disposition", "what", "where_recorded", "why", "agent_ids", "redaction_level", "sha256"]
      },
      {
        "table": "moral_trade_state_transition_events",
        "objectSchemaKey": "state_transition_event_record",
        "accessModel": "owner_insert_public_or_owner_read",
        "requiredColumns": ["id", "owner_profile_id", "subject_kind", "subject_id", "from_status", "to_status", "provenance_activity", "actor_agent_id", "idempotency_key", "event_hash"]
      }
    ],
    "accessRules": [
      "No anonymous writes to provenance persistence tables.",
      "No update or delete policies are defined for provenance persistence tables; corrections append new activities or review decisions.",
      "Public reads require redaction_level=public and must not include raw private wishes, contact details, source notes, payment secrets, or unredacted evidence artifacts."
    ]
  },
  "qualityMetrics": [
    "draft_completion_rate",
    "blocked_proposal_precision",
    "privacy_leakage_incidents",
    "explanation_helpfulness",
    "false_match_rate",
    "subgroup_surfacing_parity",
    "human_overrule_rate",
    "appeal_overturn_rate"
  ]
}
