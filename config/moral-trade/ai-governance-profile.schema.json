{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.moraltrade.org/schemas/moral-trade/ai-governance-profile.schema.json",
  "title": "Moral Trade AI Governance Profile",
  "type": "object",
  "required": [
    "version",
    "purpose",
    "decisioningMode",
    "mlEnabledForMatching",
    "mlEnabledForStateChanges",
    "requiredDocumentationBeforeMl",
    "documentationTemplates",
    "permittedAutomation",
    "prohibitedUses",
    "fairnessDocumentation",
    "explanationControls",
    "externalStandards",
    "humanControlledDecisions",
    "governanceTests"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "decisioningMode": { "type": "string", "minLength": 1 },
    "mlEnabledForMatching": { "type": "boolean" },
    "mlEnabledForStateChanges": { "type": "boolean" },
    "requiredDocumentationBeforeMl": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["key", "label", "rule"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "documentationTemplates": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "requiredFields",
          "publicSummaryFields",
          "redactedFields",
          "reviewRule"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "requiredFields": {
            "type": "array",
            "minItems": 4,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "publicSummaryFields": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "redactedFields": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "reviewRule": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "permittedAutomation": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["key", "label", "rule"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "prohibitedUses": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["key", "label", "rule"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "fairnessDocumentation": {
      "type": "object",
      "required": ["requiredBeforeAnyMl", "metrics", "slices", "reviewRule"],
      "properties": {
        "requiredBeforeAnyMl": { "type": "boolean" },
        "metrics": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "slices": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reviewRule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "explanationControls": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["key", "label", "rule"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "externalStandards": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["key", "label", "use"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "use": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "humanControlledDecisions": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "governanceTests": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
