{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPGF Ledger Template Registry",
  "type": "object",
  "required": ["version", "currency", "mode", "templates"],
  "properties": {
    "version": { "type": "string" },
    "currency": { "const": "usd" },
    "mode": { "enum": ["non_real_money_demo", "pledge_only", "test_mode"] },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "realMoneyEligible", "entries"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "realMoneyEligible": { "const": false },
          "entries": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["account", "direction"],
              "properties": {
                "account": { "type": "string" },
                "direction": { "enum": ["debit", "credit"] }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
