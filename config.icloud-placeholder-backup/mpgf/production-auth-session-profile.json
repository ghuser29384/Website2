{
  "profileVersion": "mpgf-production-auth-session-v1",
  "enabled": true,
  "baseUrl": "https://www.moraltrade.org",
  "authProvider": "supabase",
  "loginRoute": "/login",
  "signupRoute": "/signup",
  "callbackRoute": "/auth/confirm",
  "signOutRouteOrAction": "supabase.auth.signOut via SiteTopbar",
  "returnToParam": "returnTo",
  "allowedRedirectOrigins": ["https://www.moraltrade.org"],
  "allowedPostAuthRoutes": ["/mpgf", "/mpgf/contribute", "/mpgf/account/contributions", "/mpgf/pools/new"],
  "requiredProviderRedirectUrls": ["https://www.moraltrade.org/auth/confirm"],
  "safeReturnToPrefix": "/mpgf",
  "sessionCookieScope": "host_only",
  "sessionCookieSameSite": "lax",
  "secureCookiesRequired": true,
  "csrfProtectionRequired": true,
  "emailConfirmationMode": "optional",
  "inviteDeliveryMode": "not_required",
  "accountProvisioningMode": "repository_profile_mapping",
  "supportRouteOrEmail": "support@moraltrade.org",
  "csrfRequired": true,
  "createsAdminSession": false,
  "createsRealMoneyEligibility": false
}
