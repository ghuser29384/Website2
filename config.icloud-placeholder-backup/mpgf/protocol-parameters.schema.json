{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPGF Protocol Parameters",
  "type": "object",
  "required": [
    "version",
    "formalMechanismVersion",
    "thetaVersion",
    "termsVersion",
    "privacyVersion",
    "stage",
    "currency",
    "realMoneyEnabled",
    "representativeQuorumBps",
    "maxAllocationAlternatives"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "formalMechanismVersion": { "type": "string", "minLength": 1 },
    "thetaVersion": { "type": "string", "minLength": 1 },
    "termsVersion": { "type": "string", "minLength": 1 },
    "privacyVersion": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["pilot", "public_beta", "mature"] },
    "currency": { "const": "usd" },
    "realMoneyEnabled": { "const": false },
    "representativeQuorumBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "strongNegativeThresholdBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "maxAllocationAlternatives": { "type": "integer", "minimum": 1 },
    "maxBallotWeightBps": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "riskCapBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "tailLossCapBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "fallbackCarryoverBps": { "type": "integer", "minimum": 0, "maximum": 10000 }
  },
  "additionalProperties": true
}
