{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moraltrade.org/schemas/reciprocal-trade-research-eligibility-decision.v1.json",
  "title": "Reciprocal Trade research eligibility decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evaluatorVersion", "policySourceManifestHash", "effectiveAt", "subjectMode", "eligible", "reasonCodes", "unknownBlockers", "staleSourceBlockers", "canonicalEligibilitySourceStatus", "realGraphDiagnosticsStatus", "executionDecision", "assignmentGenerated", "assignmentSeedGenerated", "participantLevelCausalClaim"],
  "properties": {
    "schemaVersion": { "const": "reciprocal-trade-research-eligibility-decision-v1.0.0" },
    "evaluatorVersion": { "const": "reciprocal-trade-research-eligibility-v1.0.0" },
    "policySourceManifestHash": { "const": "sha256:7ab1d8d53c9b761ea93c4ab324c11c388316591bf90f5a21222f5fbb44de2606" },
    "effectiveAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$" },
    "subjectMode": { "enum": ["synthetic", "protected", "invalid"] },
    "eligible": { "type": "boolean" },
    "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
    "unknownBlockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
    "staleSourceBlockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
    "canonicalEligibilitySourceStatus": { "const": "blocked_source_conflict" },
    "realGraphDiagnosticsStatus": { "const": "blocked_not_run" },
    "executionDecision": { "const": "no_launch" },
    "assignmentGenerated": { "const": false },
    "assignmentSeedGenerated": { "const": false },
    "participantLevelCausalClaim": { "type": "null" }
  }
}
