  "oneOf": [
    { "properties": { "candidatePolicySatisfied": { "const": true }, "candidateReasonCodes": { "maxItems": 0 } } },
    { "properties": { "candidatePolicySatisfied": { "const": false }, "candidateReasonCodes": { "minItems": 1 } } }
