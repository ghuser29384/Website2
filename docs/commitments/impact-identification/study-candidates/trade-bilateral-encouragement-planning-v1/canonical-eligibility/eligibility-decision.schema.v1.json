    "effectiveAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-9]))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$" },
    "subjectMode": { "enum": ["synthetic", "protected", "invalid"] },
    "candidatePolicySatisfied": { "type": "boolean" },
    "candidateReasonCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/candidateReasonCode" } },
    "globalBlockerReasons": { "type": "array", "minItems": 2, "uniqueItems": true, "prefixItems": [{ "const": "CANONICAL_ELIGIBILITY_SOURCE_CONFLICT" }, { "const": "GATE_EVIDENCE_PROVENANCE_UNRESOLVED" }], "items": { "$ref": "#/$defs/globalBlockerReason" } },
    "eligible": { "const": false },
    "reasonCodes": { "type": "array", "minItems": 2, "uniqueItems": true, "prefixItems": [{ "const": "CANONICAL_ELIGIBILITY_SOURCE_CONFLICT" }, { "const": "GATE_EVIDENCE_PROVENANCE_UNRESOLVED" }], "items": { "$ref": "#/$defs/reasonCode" } },
    "unknownBlockers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/candidateReasonCode" } },
    "staleSourceBlockers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/candidateReasonCode" } },
    "canonicalEligibilitySourceStatus": { "const": "blocked_source_conflict" },
    "realGraphDiagnosticsStatus": { "const": "blocked_not_run" },
    "protectedDataExportAuthorized": { "const": false },
    "executionDecision": { "const": "no_launch" },
    "assignmentGenerated": { "const": false },
    "assignmentSeedGenerated": { "const": false },
    "participantLevelCausalClaim": { "type": "null" }
  },
