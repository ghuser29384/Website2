{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moraltrade.org/schemas/reciprocal-trade-research-eligibility-input.v1.json",
  "title": "Reciprocal Trade research eligibility normalized input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evaluatorVersion", "policySourceManifestHash", "effectiveAt", "subjectMode", "studyAuthorization", "provenance", "sourceOffer", "targetOffer", "pair"],
  "properties": {
    "schemaVersion": { "const": "reciprocal-trade-research-eligibility-input-v1.0.0" },
    "evaluatorVersion": { "const": "reciprocal-trade-research-eligibility-v1.0.0" },
    "policySourceManifestHash": { "const": "sha256:7ab1d8d53c9b761ea93c4ab324c11c388316591bf90f5a21222f5fbb44de2606" },
    "effectiveAt": { "$ref": "#/$defs/requiredTimestamp" },
    "subjectMode": { "enum": ["synthetic", "protected"] },
    "studyAuthorization": { "$ref": "#/$defs/studyAuthorization" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "sourceOffer": { "$ref": "#/$defs/offer" },
    "targetOffer": { "$ref": "#/$defs/offer" },
    "pair": { "$ref": "#/$defs/pair" }
  },
  "$defs": {
    "timestamp": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "requiredTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safeKey": {
      "type": "string",
      "pattern": "^(synthetic:[a-z0-9][a-z0-9_-]{0,63}|pseudonym:sha256:[a-f0-9]{64})$"
    },
    "studyAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectedDataExportAuthorized", "privacyReviewStatus", "ethicsDeterminationStatus", "consentOrWaiverStatus", "assignmentAuthorized", "participantContactAuthorized"],
      "properties": {
        "protectedDataExportAuthorized": { "type": "boolean" },
        "privacyReviewStatus": { "enum": ["approved", "required_not_completed", "rejected", "unknown"] },
        "ethicsDeterminationStatus": { "enum": ["approved", "required_not_completed", "rejected", "unknown"] },
        "consentOrWaiverStatus": { "enum": ["approved", "required_not_completed", "rejected", "unknown"] },
        "assignmentAuthorized": { "type": "boolean" },
        "participantContactAuthorized": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundBaseCommit", "sourceKind", "snapshotKey", "snapshotSha256", "syntheticClusterCount", "containsRealRows", "recommendationEdgeUsed", "participantCausalOutputRequested", "assignmentMaterialPresent"],
      "properties": {
        "boundBaseCommit": { "const": "79ca382c3bdc325dfc5a28e2cbbafc1b95640386" },
        "sourceKind": { "enum": ["synthetic_fixture", "protected_normalized_snapshot"] },
        "snapshotKey": { "$ref": "#/$defs/safeKey" },
        "snapshotSha256": { "$ref": "#/$defs/sha256" },
        "syntheticClusterCount": { "type": "integer", "minimum": 0, "maximum": 3200 },
        "containsRealRows": { "type": "boolean" },
        "recommendationEdgeUsed": { "type": "boolean" },
        "participantCausalOutputRequested": { "type": "boolean" },
        "assignmentMaterialPresent": { "type": "boolean" }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceStatus", "sourceHash", "reviewedAt", "expiresAt"],
      "properties": {
        "status": { "enum": ["cleared", "blocked", "review_required", "unknown", "stale", "contradictory"] },
        "sourceStatus": { "enum": ["current", "stale", "unknown", "unbound", "contradictory"] },
        "sourceHash": { "$ref": "#/$defs/sha256" },
        "reviewedAt": { "$ref": "#/$defs/requiredTimestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offerKey", "ownerKey", "mode", "offeredCause", "requestedCause", "causeCollation", "workflowStatus", "status", "operability", "gates"],
      "properties": {
        "offerKey": { "$ref": "#/$defs/safeKey" },
        "ownerKey": { "$ref": "#/$defs/safeKey" },
        "mode": { "enum": ["pledge", "offset", "payment"] },
        "offeredCause": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[\\u0020-\\u007e]+$" },
        "requestedCause": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[\\u0020-\\u007e]+$" },
        "causeCollation": { "const": "postgres-ilike-printable-ascii-v1" },
        "workflowStatus": { "enum": ["draft", "pending_review", "published", "changes_requested", "rejected", "paused", "closed", "deleted"] },
        "status": { "enum": ["open", "paused", "matched", "closed"] },
        "operability": { "enum": ["operative", "expired", "superseded", "withdrawn", "blocked", "unknown", "stale", "contradictory"] },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["moderation", "harmfulOffer", "baselineIntegrity", "legality", "participantEligibility"],
          "properties": {
            "moderation": { "$ref": "#/$defs/gateEvidence" },
            "harmfulOffer": { "$ref": "#/$defs/gateEvidence" },
            "baselineIntegrity": { "$ref": "#/$defs/gateEvidence" },
            "legality": { "$ref": "#/$defs/gateEvidence" },
            "participantEligibility": { "$ref": "#/$defs/gateEvidence" }
          }
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "allowedRole", "purposeCode", "privacyScope", "sourceStatus", "grantHash", "startsAt", "expiresAt", "revokedAt"],
      "properties": {
        "status": { "enum": ["current", "absent", "revoked", "stale", "scope_mismatch", "unknown", "contradictory"] },
        "allowedRole": { "enum": ["source_only", "target_only", "bidirectional", "none"] },
        "purposeCode": { "const": "reciprocal_trade_research_eligibility_v1" },
        "privacyScope": { "const": "research_eligibility_normalized_pair_only" },
        "sourceStatus": { "enum": ["current", "stale", "unknown", "unbound", "contradictory"] },
        "grantHash": { "$ref": "#/$defs/sha256" },
        "startsAt": { "$ref": "#/$defs/requiredTimestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "revokedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceStatus", "startsAt", "expiresAt", "revokedAt"],
      "properties": {
        "status": { "enum": ["clear", "active", "reviewing", "expired", "revoked", "unknown", "contradictory"] },
        "sourceStatus": { "enum": ["current", "stale", "unknown", "unbound", "contradictory"] },
        "startsAt": { "$ref": "#/$defs/requiredTimestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "revokedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedInterest", "invitation", "thread", "agreement", "duplicatePair", "historicalInterference"],
      "properties": {
        "acceptedInterest": { "enum": ["none", "active", "terminal", "unknown", "contradictory"] },
        "invitation": { "enum": ["none", "active", "terminal", "unknown", "contradictory"] },
        "thread": { "enum": ["none", "active", "terminal", "unknown", "contradictory"] },
        "agreement": { "enum": ["none", "active", "terminal", "unknown", "contradictory"] },
        "duplicatePair": { "enum": ["none", "present", "unknown", "contradictory"] },
        "historicalInterference": { "enum": ["captured", "none", "unknown", "contradictory"] }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockStatus", "sourceRestriction", "targetRestriction", "pairRestriction", "sourceConsent", "targetConsent", "engagement"],
      "properties": {
        "blockStatus": { "enum": ["clear", "blocked_source_to_target", "blocked_target_to_source", "blocked_both", "unknown", "contradictory"] },
        "sourceRestriction": { "$ref": "#/$defs/restriction" },
        "targetRestriction": { "$ref": "#/$defs/restriction" },
        "pairRestriction": { "$ref": "#/$defs/restriction" },
        "sourceConsent": { "$ref": "#/$defs/consent" },
        "targetConsent": { "$ref": "#/$defs/consent" },
        "engagement": { "$ref": "#/$defs/engagement" }
      }
    }
  }
}
