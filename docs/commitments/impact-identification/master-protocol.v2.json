        "supportedExposureCells",
        "emptyExposureCellAction",
        "primaryEstimand",
        "potentialOutcomeContrast",
        "targetPopulation",
        "primaryOutcome",
        "outcomeWindow",
        "estimator",
        "varianceProcedure",
        "finiteSampleInference",
        "unequalClusterSizeHandling",
        "covariateAdjustmentPolicy",
        "missingnessEstimand",
        "attritionBounds",
        "sensitivityAnalyses",
        "graphDiagnostics",
        "precisionSimulation",
        "fixedHorizonOrSequentialDesign",
        "ethicsDetermination",
        "participantDefinition",
        "consentOrWaiver",
        "controlConditionJustification",
        "vulnerableParticipantProtections",
        "debriefingPolicy",
        "adverseEventMonitoring",
        "stopAndSuspensionRules",
        "privacyRetentionAndDeletion",
        "accessControl",
        "incidentResponse",
        "entropySource",
        "seedGenerationProcedure",
        "seedCommitment",
        "constrainedRandomizationRule",
        "assignmentConcealment",
        "outcomeAdjudicatorBlinding",
        "unblindingLog",
        "postAssignmentEligibilityChangeLog",
        "differentialEvidenceResolutionAudit",
        "blockingSafetyOutcomes",
        "contaminationAndSpilloverMonitoring",
        "offPlatformSubstitutionAudit",
        "resourceClaimDeduplication",
        "analysisCodeHash",
        "protocolPayloadHash",
        "templatePayloadHash",
        "studyInstancePayloadHash",
        "appendOnlyRegistryRecord",
        "protectedTagOrEquivalent",
        "amendmentLog",
        "deviationLog"
      ],
      "ethicsGovernance": {
        "independentDeterminationRequired": true,
        "gatekeeperPermissionIsNotParticipantConsent": true,
        "requiredDeterminations": [
          "who counts as a research participant",
          "whether informed consent is required",
          "whether a waiver or alteration is independently permissible and justified by minimal risk and infeasibility",
          "whether the control condition withholds an entitlement",
          "jurisdiction and institution-specific obligations"
        ],
        "requiredProtections": [
          "minors and vulnerable users",
          "hierarchical, social, economic, or relational pressure",
          "debriefing where applicable",
          "adverse-event monitoring",
          "prespecified stop or suspension rules",
          "privacy, retention, access, deletion, and incident response"
        ],
        "status": "required_not_completed"
      },
      "allocationConcealment": {
        "eligibilityFrozenBeforeSeedGeneration": true,
        "entropySourceMustBeFrozen": true,
        "seedShoppingProhibited": true,
        "undisclosedRerandomizationProhibited": true,
        "constrainedRandomizationRequiresFrozenAdmissibleSetAndSelectionRule": true,
        "assignmentConcealedUntilEligibilityIrreversible": true,
        "outcomeAdjudicatorBlindingRequiredWhereFeasible": true,
        "allUnblindingAndPostAssignmentEligibilityChangesLogged": true,
        "differentialEvidenceResolutionAuditedByArm": true
      },
      "precisionAndStopping": {
        "provisionalObservationFloorsAreNotStudySampleSizes": true,
        "simulationRequiredBeforeLaunch": true,
        "requiredInputs": [
          "number of independent randomized clusters",
          "cluster-size distribution",
          "assignment and saturation probabilities",
          "supported exposure-cell probabilities",
          "intracluster correlation",
          "spillover strength",
          "noncompliance",
          "contamination",
          "attrition",
          "cluster-size imbalance"
        ],
        "requiredOutputs": [
          "effective sample size",
          "expected exposure-cell counts",
          "interval-width or decision-loss target",
          "simulation code hash and seed",
          "sensitivity grid",
          "no-launch determination"
        ],
        "optionalStoppingProhibited": true,
        "fixedHorizonOrValidSequentialDesignRequired": true,
        "scientificIntervalLevelBps": 9500,
        "productPredictiveIntervalLevelBps": 8000
      },
      "safetyVetoPolicy": {
        "safetyOutcomesAreVetoes": true,
        "noImplicitMoralAggregation": true,
        "requiredBlockingOutcomes": [
          "harmful-offer or threat indicator",
          "baseline manufacture or worsening after eligibility becomes salient",
          "harm shifted to nonparticipants",
          "coercion, harassment, identity exposure, or retaliation",
          "concentration or exclusion effect",
          "off-platform substitution",
          "duplicate or overlapping resource claim"
        ],
        "prohibitedStudyArms": [
          "illegal, violent, deceptive, coercive, or harassing offer",
          "disabled harmful-offer enforcement",
          "reward for manufacturing a worse baseline",
          "encouragement to create harm so another party will pay to stop it",
          "suppression of required safety information",
          "identity disclosure contrary to frozen mechanism terms"
        ]
      },
      "provenanceAndImmutability": {
        "canonicalPayloadHashRequired": true,
        "signedProtectedTagOrEquivalentRequiredBeforeApproval": true,
        "appendOnlyRegistryRequiredBeforeAssignment": true,
        "registryMustBind": [
          "protocol payload hash",
          "template payload hash",
          "study-instance payload hash",
          "founder approval record",
          "eligible-population snapshot hash",
          "assignment-code hash",
          "analysis-code hash",
          "seed commitment",
          "ethics determination reference",
          "amendment log"
        ],
        "preAssignmentAmendmentsAndPostAssignmentDeviationsSeparated": true
      },
      "primaryOutcomeRule": "Exactly one scalar native-unit primary outcome or one fully prespecified multivariate global test per immutable study instance.",
      "missingnessRule": "Resolution failure, attrition, and missing outcome evidence are reported by assignment arm and cannot be silently dropped.",
      "covariateAdjustmentRule": "Covariate adjustment is frozen before assignment and used for precision only unless a separate exact identification argument is approved.",
      "noLaunchRule": "If independent clusters, supported exposure cells, ethics, concealment, precision, safety, or provenance gates are inadequate, the study is not launched."
    },
