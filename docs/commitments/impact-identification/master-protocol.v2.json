      "founderReviewId": 4905684444,
      "founderReviewDecision": "changes_required"
    },
    "purpose": "Define fail-closed, reproducible, ethics-gated, interference-aware evidence contracts for policy-level causal studies and predictive calibration without authorizing participant-specific causal credit or any live experiment.",
    "executionAuthorization": {
      "authorized": false,
      "environment": "none",
      "prohibitedActions": [
        "assign a real user",
        "instrument production treatment assignment",
        "change matching, bonus, payment, invitation, or reveal terms for research",
        "approve or activate a PR #534 methodology",
        "publish participant expected additional or direct causal attribution",
        "apply a database migration",
        "merge or deploy on the basis of this under-review protocol"
      ]
    },
    "sourceBoundary": {
      "conceptualBasisRefs": [
        "source:toby-ord-moral-trade-2015",
        "source:forethought-convergence-and-compromise-2025",
        "source:forethought-moral-public-goods-2026"
      ],
      "statisticalMethodRefs": [
        {
          "citation": "Hudgens and Halloran (2008), Toward Causal Inference With Interference",
          "identifier": "doi:10.1198/016214508000000292",
          "role": "partial-interference estimands and two-stage randomized designs"
        },
        {
          "citation": "Aronow and Samii (2017), Estimating Average Causal Effects Under General Interference",
          "identifier": "doi:10.1214/16-AOAS1005",
          "role": "joint specification of design, exposure mapping, and estimand under interference"
        },
        {
          "citation": "Kang and Imbens (2016), Peer Encouragement Designs in Causal Inference with Partial Interference",
          "identifier": "arxiv:1609.04464",
          "role": "peer encouragement, noncompliance, and local-effect limits"
        },
        {
          "citation": "Jiang, Imai, and Malani (2023), Statistical Inference and Power Analysis for Direct and Spillover Effects in Two-Stage Randomized Experiments",
          "identifier": "doi:10.1111/biom.13782",
          "role": "design-based inference and power analysis for two-stage experiments"
        },
        {
          "citation": "Steyerberg et al. (2010), Assessing the Performance of Prediction Models",
          "identifier": "doi:10.1097/EDE.0b013e3181c30fb2",
          "role": "separation of calibration, discrimination, and overall predictive performance"
        },
        {
          "citation": "Van Calster et al. (2016), A Calibration Hierarchy for Risk Models",
          "identifier": "doi:10.1016/j.jclinepi.2015.12.005",
          "role": "calibration-in-the-large, slope, and flexible calibration"
        }
      ],
      "calibrationEvidenceRefs": [],
      "rule": "Conceptual sources and methods literature define concerns and design principles; they are not empirical evidence about Moral Trade users, outcomes, or model calibration."
    },
    "evidenceStreams": {
      "outcomePrediction": {
        "purpose": "predict outcome risk or quantity",
        "requiredValidation": [
          "time-respecting development",
          "untouched later-time or otherwise independent holdout",
          "proper scoring rules",
          "calibration and interval diagnostics with uncertainty"
        ],
        "doesNotValidate": [
          "causal identification",
          "participant impact",
          "transportability"
        ]
      },
      "causalIdentification": {
        "purpose": "identify an exact assignment-policy or separately approved participant-action estimand",
        "primaryDefault": "assignment_policy_itt",
        "requiredValidation": [
          "design, exposure mapping, and estimand specified together",
          "design-based estimator and variance",
          "interference and contamination handling",
          "overlap or positivity where relevant",
          "prespecified sensitivity analyses"
        ],
        "doesNotValidate": [
          "outcome-model calibration",
          "future-population transportability"
        ]
      },
      "transportability": {
        "purpose": "bound generalization from study population and policy to a named target population and later period",
        "requiredValidation": [
          "target population and period",
          "effect-modifier support",
          "population overlap",
          "temporal drift",
          "replication or prospective external validation"
        ],
        "doesNotValidate": [
          "invalid randomization",
          "invalid evidence",
          "unidentified individual effects"
        ]
      }
    },
    "productClaimPolicy": {
      "evidenceToProductMappingFile": "evidence-to-product-mapping.v2.json",
      "policyLevelEvidenceMaySupportPolicyClaims": true,
      "policyLevelEvidenceAuthorizesParticipantCausalCredit": false,
      "localEffectsArePopulationSpecific": true,
      "localEffectsAreNonAdditive": true,
      "participantExpectedAdditionalDefault": "withheld",
      "participantDirectCausalAttributionDefault": "withheld",
      "verifiedOutcomeEstablishesCounterfactual": false,
      "highConfidenceAllowed": false
    },
    "masterStudyInstanceContract": {
      "requiredBindingNames": [
        "studyKey",
        "studyVersion",
        "mechanismFamily",
        "studyVariant",
        "eligiblePopulationSnapshotHash",
        "eligibilityRules",
        "exclusionRules",
        "assignmentUnit",
        "exposureUnit",
