{
  "buildCommand": "npm run verify:reminders && npm run build",
  "crons": [
    {
      "path": "/api/jobs/saved-searches",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/jobs/delegates",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/jobs/email",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/trade-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/jobs/background-networking",
      "schedule": "0 * * * *"
    }
  ]
}
