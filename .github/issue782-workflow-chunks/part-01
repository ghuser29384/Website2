name: Issue 782 bounded canonical reviewer UAT

on:
  push:
    branches:
      - ops/dac-production-canonical-uat-26d1fe43-20260824
    paths:
      - ".github/workflows/dac-production-issue782-bounded-reviewer-uat-20260826.yml"
      - ".github/scripts/issue782-render-run-owned-dac-fixtures.mjs"
      - ".github/scripts/issue782-production-auth-create-uat.mjs"

permissions:
  actions: write
  contents: read
  issues: write

concurrency:
  group: moraltrade-issue782-bounded-canonical-reviewer-uat
  cancel-in-progress: false

env:
  CONTROLLER_BRANCH: ops/dac-production-canonical-uat-26d1fe43-20260824
  WORKFLOW_PATH: .github/workflows/dac-production-issue782-bounded-reviewer-uat-20260826.yml
  RENDERER_PATH: .github/scripts/issue782-render-run-owned-dac-fixtures.mjs
  UAT_SCRIPT_PATH: .github/scripts/issue782-production-auth-create-uat.mjs
  EXPECTED_MAIN_SHA: 26d1fe436dbf9a4440bfafd501ddf8db944a1127
  EXPECTED_MAIN_TREE: 47fe96dfc881f1c57dea711283fc3db36a44e053
  EXPECTED_PROJECT_REF: jnpoxvalyjtdghnperyu
  EXPECTED_POOLER_HOST: aws-1-us-west-2.pooler.supabase.com
  EXPECTED_POOLER_USER: postgres.jnpoxvalyjtdghnperyu
  ORIGINAL_DEPLOYMENT_ID: dpl_GbKHA9YfvjEW3iqymgY4uzp7MWsX
  ORIGINAL_DEPLOYMENT_URL: https://moraltrade-site-8l8gym3ca-ellen-s.vercel.app
  VERCEL_PROJECT_ID: prj_Em3j7Uj7RatX2R1ZYhla3XSHRde7
  VERCEL_TEAM_ID: team_ySu6sF3Uho1E1GnJtCQPVEuJ
  VERCEL_CLI_VERSION: 50.38.1
  BACKUP_RUN_ID: "32904854234"
  BACKUP_ARTIFACT_ID: "9584433427"
  BACKUP_ARTIFACT_DIGEST: sha256:773149dde3b2512b3854e48c5adf1b1b4c16a627be3ed2c21207d947d9885835
  BACKUP_EXPIRES_AT: 2026-09-24T22:11:58Z
  ADMIN_PREFLIGHT_RUN_ID: "32905560434"
  ADMIN_PREFLIGHT_ARTIFACT_ID: "9584649790"
  ADMIN_PREFLIGHT_ARTIFACT_DIGEST: sha256:01617553a14869bc97734c4a3cf7577c34e8e0cf34e9941b9b069d3efc2ce934
  POSTGRES_IMAGE: postgres:17
  EVIDENCE_DIR: issue782-bounded-reviewer-uat-evidence
  GENERATED_DIR: issue782-generated
  CANONICAL_ORIGINS: https://www.moraltrade.org,https://moraltrade.org

jobs:
  execute:
    name: Exact-state temporary enablement, canonical UAT, and unconditional restoration
    runs-on: ubuntu-24.04
    timeout-minutes: 170
    outputs:
      namespace: ${{ steps.namespace.outputs.namespace }}
      prefix: ${{ steps.namespace.outputs.prefix }}
      reviewer_email_hash: ${{ steps.namespace.outputs.reviewer_email_hash }}
      temporary_deployment_id: ${{ steps.release_evidence.outputs.deployment_id }}
      temporary_deployment_url: ${{ steps.release_evidence.outputs.deployment_url }}
      release_run_id: ${{ steps.release.outputs.release_run_id }}
      release_dispatch_epoch: ${{ steps.release.outputs.release_dispatch_epoch }}
      uat_exit_code: ${{ steps.uat.outputs.exit_code }}
      cleanup_exit_code: ${{ steps.cleanup.outputs.exit_code }}
      alias_started_epoch: ${{ steps.release_evidence.outputs.alias_started_epoch }}
    env:
      GH_TOKEN: ${{ github.token }}
      VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
      PROD_SUPABASE_DB_URL: ${{ secrets.PROD_SUPABASE_DB_URL }}

    steps:
      - name: Check out exact one-use controller
        uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0

      - name: Guard exact source, controller-only scope, and release concurrency
        shell: bash
        run: |
          set -euo pipefail
          test "$GITHUB_REPOSITORY" = "ghuser29384/Website2"
          test "$GITHUB_REF_NAME" = "$CONTROLLER_BRANCH"
          test "$(git rev-parse HEAD)" = "$GITHUB_SHA"
          test "$(git merge-base HEAD "$EXPECTED_MAIN_SHA")" = "$EXPECTED_MAIN_SHA"
          test "$(git rev-parse "$EXPECTED_MAIN_SHA^{tree}")" = "$EXPECTED_MAIN_TREE"
          remote_main="$(git ls-remote origin refs/heads/main | awk '{print $1}')"
          test "$remote_main" = "$EXPECTED_MAIN_SHA"
          mapfile -t changed < <(git diff --name-only "$EXPECTED_MAIN_SHA" HEAD | sort)
          printf '%s\n' "${changed[@]}" > "$RUNNER_TEMP/changed-files.txt"
          printf '%s\n' "$RENDERER_PATH" "$UAT_SCRIPT_PATH" "$WORKFLOW_PATH" | sort > "$RUNNER_TEMP/expected-files.txt"
          diff -u "$RUNNER_TEMP/expected-files.txt" "$RUNNER_TEMP/changed-files.txt"
          git diff --check "$EXPECTED_MAIN_SHA" HEAD
          active_release_count="$(gh api \
            "repos/$GITHUB_REPOSITORY/actions/workflows/vercel-release.yml/runs?event=workflow_dispatch&per_page=50" \
            | jq '[.workflow_runs[] | select(.status != "completed")] | length')"
          test "$active_release_count" = "0"
          mkdir -p "$EVIDENCE_DIR" "$GENERATED_DIR"
          jq -n \
            --arg repository "$GITHUB_REPOSITORY" \
            --arg controllerSha "$GITHUB_SHA" \
            --arg mainSha "$EXPECTED_MAIN_SHA" \
            --arg mainTree "$EXPECTED_MAIN_TREE" \
            --arg remoteMain "$remote_main" \
            --argjson activeReleaseCount "$active_release_count" \
            --arg checkedAt "$(date -u +%FT%TZ)" \
            '{repository:$repository,controllerSha:$controllerSha,mainSha:$mainSha,mainTree:$mainTree,remoteMain:$remoteMain,controllerOnlyDiff:true,activeReleaseCount:$activeReleaseCount,checkedAt:$checkedAt}' \
            > "$EVIDENCE_DIR/source-identity.json"

      - name: Re-prove exact unexpired backup and prior redacted admin classification
        shell: bash
        run: |
          set -euo pipefail
          gh api "repos/$GITHUB_REPOSITORY/actions/runs/$BACKUP_RUN_ID" > "$RUNNER_TEMP/backup-run.json"
          gh api "repos/$GITHUB_REPOSITORY/actions/artifacts/$BACKUP_ARTIFACT_ID" > "$RUNNER_TEMP/backup-artifact.json"
          gh api "repos/$GITHUB_REPOSITORY/actions/runs/$ADMIN_PREFLIGHT_RUN_ID" > "$RUNNER_TEMP/admin-run.json"
          gh api "repos/$GITHUB_REPOSITORY/actions/artifacts/$ADMIN_PREFLIGHT_ARTIFACT_ID" > "$RUNNER_TEMP/admin-artifact.json"
          jq -e --arg sha "$EXPECTED_MAIN_SHA" '.status=="completed" and .conclusion=="success"' "$RUNNER_TEMP/backup-run.json" >/dev/null
          jq -e --argjson id "$BACKUP_ARTIFACT_ID" --arg digest "$BACKUP_ARTIFACT_DIGEST" --arg expires "$BACKUP_EXPIRES_AT" '
            .id==$id and .expired==false and .digest==$digest and .expires_at==$expires and (.expires_at|fromdateiso8601)>now
          ' "$RUNNER_TEMP/backup-artifact.json" >/dev/null
          jq -e '.status=="completed" and .conclusion=="success"' "$RUNNER_TEMP/admin-run.json" >/dev/null
          jq -e --argjson id "$ADMIN_PREFLIGHT_ARTIFACT_ID" --arg digest "$ADMIN_PREFLIGHT_ARTIFACT_DIGEST" '
            .id==$id and .expired==false and .digest==$digest
          ' "$RUNNER_TEMP/admin-artifact.json" >/dev/null
          jq -n \
            --argjson backupRunId "$BACKUP_RUN_ID" \
            --argjson backupArtifactId "$BACKUP_ARTIFACT_ID" \
            --arg backupDigest "$BACKUP_ARTIFACT_DIGEST" \
            --arg backupExpiresAt "$BACKUP_EXPIRES_AT" \
            --argjson adminRunId "$ADMIN_PREFLIGHT_RUN_ID" \
            --argjson adminArtifactId "$ADMIN_PREFLIGHT_ARTIFACT_ID" \
            --arg adminDigest "$ADMIN_PREFLIGHT_ARTIFACT_DIGEST" \
            --arg verifiedAt "$(date -u +%FT%TZ)" \
            '{backup:{runId:$backupRunId,artifactId:$backupArtifactId,digest:$backupDigest,expiresAt:$backupExpiresAt,available:true},adminPreflight:{runId:$adminRunId,artifactId:$adminArtifactId,digest:$adminDigest,success:true},verifiedAt:$verifiedAt}' \
            > "$EVIDENCE_DIR/prerequisite-evidence.json"

      - name: Guard exact deployment and both canonical aliases before mutation
        shell: bash
        run: |
          set -euo pipefail
          test -n "${VERCEL_TOKEN:-}"
          echo "::add-mask::$VERCEL_TOKEN"
          curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
            "https://api.vercel.com/v13/deployments/$ORIGINAL_DEPLOYMENT_ID?teamId=$VERCEL_TEAM_ID" \
            > "$RUNNER_TEMP/original-deployment.json"
          jq -e --arg id "$ORIGINAL_DEPLOYMENT_ID" --arg project "$VERCEL_PROJECT_ID" --arg sha "$EXPECTED_MAIN_SHA" '
            ((.id // .uid)==$id)
            and ((.projectId // .project.id // "")==$project)
            and ((.readyState // .state // "")=="READY")
            and (.target=="production")
            and (.meta.githubCommitSha==$sha)
            and ((.aliasError // null)==null)
            and ((.alias // .aliases // []) | any(.=="moraltrade.org"))
            and ((.alias // .aliases // []) | any(.=="www.moraltrade.org"))
          ' "$RUNNER_TEMP/original-deployment.json" >/dev/null
          mkdir -p "$EVIDENCE_DIR/aliases-before"
          for alias_name in moraltrade.org www.moraltrade.org; do
            key="${alias_name//./-}"
            curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
              "https://api.vercel.com/v4/aliases/$alias_name?projectId=$VERCEL_PROJECT_ID&teamId=$VERCEL_TEAM_ID" \
              > "$RUNNER_TEMP/alias-before-$key.json"
            jq -e --arg alias "$alias_name" --arg project "$VERCEL_PROJECT_ID" --arg deployment "$ORIGINAL_DEPLOYMENT_ID" '
              (.alias==$alias) and (.projectId==$project) and ((.deploymentId // .deployment.id // .deployment.uid // "")==$deployment)
            ' "$RUNNER_TEMP/alias-before-$key.json" >/dev/null
            jq '{alias,projectId,deploymentId:(.deploymentId // .deployment.id // .deployment.uid)}' \
              "$RUNNER_TEMP/alias-before-$key.json" > "$EVIDENCE_DIR/aliases-before/$key.json"
          done
          jq -n \
            --arg deploymentId "$ORIGINAL_DEPLOYMENT_ID" \
            --arg projectId "$VERCEL_PROJECT_ID" \
            --arg sha "$EXPECTED_MAIN_SHA" \
            --arg checkedAt "$(date -u +%FT%TZ)" \
            '{deploymentId:$deploymentId,projectId:$projectId,sha:$sha,ready:true,target:"production",aliases:["moraltrade.org","www.moraltrade.org"],checkedAt:$checkedAt}' \
            > "$EVIDENCE_DIR/original-deployment.json"

      - name: Set up Node, exact dependencies, Chromium, and PostgreSQL 17
