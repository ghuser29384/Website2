            config.match(/const DEFAULT_PUBLIC_SUPABASE_URL = "([^"]+)";/)?.[1];
          const key = values.get('NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY') ??
            values.get('NEXT_PUBLIC_SUPABASE_ANON_KEY') ??
            config.match(/const DEFAULT_PUBLIC_SUPABASE_PUBLISHABLE_KEY =\s*"([^"]+)";/)?.[1];
          const service = values.get('SUPABASE_SERVICE_ROLE_KEY');
          if (!url || !key || !service) throw new Error('Could not resolve exact production Supabase configuration.');
          if (new URL(url).hostname.split('.')[0] !== process.env.EXPECTED_PROJECT_REF) {
            throw new Error('Supabase URL does not target exact production.');
          }
          const quote = (value) => `'${String(value).replaceAll("'", "'\\''")}'`;
          fs.writeFileSync(process.env.OUTPUT_ENV, [
            `export NEXT_PUBLIC_SUPABASE_URL=${quote(url)}`,
            `export NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${quote(key)}`,
            `export SUPABASE_SERVICE_ROLE_KEY=${quote(service)}`,
            '',
          ].join('\n'), { mode: 0o600 });
          NODE
          source "$RUNNER_TEMP/issue782-production-secrets.env"
          echo "::add-mask::$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
          echo "::add-mask::$SUPABASE_SERVICE_ROLE_KEY"
          rm -f .vercel/.env.production.local .vercel/.env.local "$RUNNER_TEMP/vercel-pull.log"
          jq -n \
            --arg project "$VERCEL_PROJECT_ID" \
            --arg supabaseRef "$EXPECTED_PROJECT_REF" \
            --arg checkedAt "$(date -u +%FT%TZ)" \
            '{project:$project,supabaseRef:$supabaseRef,serviceCredentialPresent:true,adminEmailsInitiallyAbsent:true,paymentProviderModesDisabled:true,valuesRetained:false,checkedAt:$checkedAt}' \
            > "$EVIDENCE_DIR/environment-preflight.json"
          echo "exit_code=0" >> "$GITHUB_OUTPUT"

      - name: Derive exact run-owned namespace and ownership manifest before mutation
        id: namespace
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          RUN_ID="$GITHUB_RUN_ID" RUN_ATTEMPT="$GITHUB_RUN_ATTEMPT" RUN_SHA="$GITHUB_SHA" \
            MANIFEST="$RUNNER_TEMP/issue782-manifest.json" \
            REDACTED="$EVIDENCE_DIR/ownership-manifest-redacted.json" \
            python3 - <<'PY'
          import hashlib, json, os, uuid
          run_id=os.environ['RUN_ID']
          attempt=os.environ['RUN_ATTEMPT']
          sha=os.environ['RUN_SHA']
          token=hashlib.sha256(f'{run_id}:{attempt}:{sha}'.encode()).hexdigest()[:10]
          prefix=f'i782-{run_id}-{attempt}-{token}'
          namespace=f'issue782:{run_id}:{attempt}:{token}'
          def email(role): return f'i782-{run_id}-{attempt}-{token}-{role}@qa.moraltrade.invalid'
          def uid(kind): return str(uuid.uuid5(uuid.NAMESPACE_URL, f'{namespace}:{kind}'))
          users={role:{'id':None,'email':email(role)} for role in ('creator','reviewer','pledger','outsider')}
          proposals={name:uid(f'proposal:{name}') for name in ('open','success','lapse')}
          submissions={name:uid(f'submission:{name}') for name in ('open','success','lapse')}
          exact={'schemaVersion':1,'namespace':namespace,'prefix':prefix,'users':users,'proposals':proposals,'submissions':submissions}
          with open(os.environ['MANIFEST'],'w') as f: json.dump(exact,f,indent=2)
          redacted={
            'schemaVersion':1,'namespace':namespace,'prefix':prefix,
            'roles':list(users),'proposalCount':len(proposals),'submissionCount':len(submissions),
            'emailHashes':{role:hashlib.sha256(data['email'].encode()).hexdigest() for role,data in users.items()},
            'proposalHashes':{name:hashlib.sha256(value.encode()).hexdigest() for name,value in proposals.items()},
            'submissionHashes':{name:hashlib.sha256(value.encode()).hexdigest() for name,value in submissions.items()},
            'createdBeforeMutation':True,
          }
          with open(os.environ['REDACTED'],'w') as f: json.dump(redacted,f,indent=2)
          print(f'namespace={namespace}')
          print(f'prefix={prefix}')
          print(f'reviewer_email={users["reviewer"]["email"]}')
          print(f'reviewer_email_hash={redacted["emailHashes"]["reviewer"]}')
          PY
          namespace="$(python3 -c 'import json;print(json.load(open("'"$RUNNER_TEMP/issue782-manifest.json"'"))["namespace"])')"
          prefix="$(python3 -c 'import json;print(json.load(open("'"$RUNNER_TEMP/issue782-manifest.json"'"))["prefix"])')"
          reviewer_email="$(python3 -c 'import json;print(json.load(open("'"$RUNNER_TEMP/issue782-manifest.json"'"))["users"]["reviewer"]["email"])')"
          reviewer_email_hash="$(printf '%s' "$reviewer_email" | sha256sum | awk '{print $1}')"
          echo "::add-mask::$reviewer_email"
          echo "ISSUE782_MANIFEST_PATH=$RUNNER_TEMP/issue782-manifest.json" >> "$GITHUB_ENV"
          echo "ISSUE782_NAMESPACE=$namespace" >> "$GITHUB_ENV"
          echo "ISSUE782_PREFIX=$prefix" >> "$GITHUB_ENV"
          echo "ISSUE782_REVIEWER_EMAIL=$reviewer_email" >> "$GITHUB_ENV"
          echo "namespace=$namespace" >> "$GITHUB_OUTPUT"
          echo "prefix=$prefix" >> "$GITHUB_OUTPUT"
          echo "reviewer_email_hash=$reviewer_email_hash" >> "$GITHUB_OUTPUT"

      - name: Create exactly one temporary production ADMIN_EMAILS variable
        id: admin_env
        shell: bash
        run: |
          set -euo pipefail
          raw="$RUNNER_TEMP/envs-before-create.json"
          curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
            "https://api.vercel.com/v10/projects/$VERCEL_PROJECT_ID/env?teamId=$VERCEL_TEAM_ID&decrypt=true&source=issue782-bounded-reviewer-uat" \
            > "$raw"
          test "$(jq '[.envs[]? | select(.key=="ADMIN_EMAILS" and ((.target|type)=="array" and (.target|index("production"))!=null or .target=="production"))] | length' "$raw")" = "0"
          payload="$(jq -nc \
            --arg value "$ISSUE782_REVIEWER_EMAIL" \
            --arg comment "issue782:$GITHUB_RUN_ID:$GITHUB_RUN_ATTEMPT" \
            '{key:"ADMIN_EMAILS",value:$value,type:"encrypted",target:["production"],comment:$comment}')"
          response="$RUNNER_TEMP/env-create.json"
          status="$(curl -sS -X POST \
            -H "Authorization: Bearer $VERCEL_TOKEN" \
            -H "Content-Type: application/json" \
            -o "$response" -w '%{http_code}' \
            --data "$payload" \
            "https://api.vercel.com/v10/projects/$VERCEL_PROJECT_ID/env?teamId=$VERCEL_TEAM_ID")"
          test "$status" = "200" -o "$status" = "201"
          env_id="$(jq -r '.id // .created[0].id // empty' "$response")"
          [[ "$env_id" =~ ^[A-Za-z0-9_]+$ ]]
          printf '%s' "$env_id" > "$RUNNER_TEMP/issue782-admin-env-id"
          echo "ISSUE782_ADMIN_ENV_ID=$env_id" >> "$GITHUB_ENV"
          verify="$RUNNER_TEMP/env-verify.json"
          curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
            "https://api.vercel.com/v10/projects/$VERCEL_PROJECT_ID/env?teamId=$VERCEL_TEAM_ID&decrypt=true&source=issue782-bounded-reviewer-uat-verify" \
            > "$verify"
          count="$(jq --arg id "$env_id" --arg value "$ISSUE782_REVIEWER_EMAIL" '
            [.envs[]? | select(.id==$id and .key=="ADMIN_EMAILS" and .value==$value and ((.target|type)=="array" and (.target|index("production"))!=null))] | length
          ' "$verify")"
          test "$count" = "1"
          jq -n \
            --arg envIdHash "$(printf '%s' "$env_id" | sha256sum | awk '{print $1}')" \
            --arg emailHash "$(printf '%s' "$ISSUE782_REVIEWER_EMAIL" | sha256sum | awk '{print $1}')" \
            --arg createdAt "$(date -u +%FT%TZ)" \
            '{key:"ADMIN_EMAILS",target:["production"],entryCount:1,envIdHash:$envIdHash,emailHash:$emailHash,realOrOwnerEmailUsed:false,createdAt:$createdAt}' \
            > "$EVIDENCE_DIR/temporary-admin-env.json"
          rm -f "$raw" "$response" "$verify"
          echo "exit_code=0" >> "$GITHUB_OUTPUT"

      - name: Dispatch and require the permanent exact-SHA production release
        id: release
        shell: bash
        run: |
          set -euo pipefail
          test "$(git ls-remote origin refs/heads/main | awk '{print $1}')" = "$EXPECTED_MAIN_SHA"
          test "$(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/vercel-release.yml/runs?event=workflow_dispatch&per_page=50" \
            | jq '[.workflow_runs[] | select(.status!="completed")] | length')" = "0"
          dispatch_started="$(date -u +%FT%TZ)"
          dispatch_epoch="$(date +%s)"
          echo "ISSUE782_RELEASE_DISPATCH_EPOCH=$dispatch_epoch" >> "$GITHUB_ENV"
          echo "release_dispatch_epoch=$dispatch_epoch" >> "$GITHUB_OUTPUT"
          gh workflow run .github/workflows/vercel-release.yml \
            --ref main \
            -f target=production \
            -f ref=main \
            -f expected_sha="$EXPECTED_MAIN_SHA" \
            -f synthetic_auth_fixture_url=
          release_run_id=""
          for attempt in $(seq 1 120); do
            runs="$(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/vercel-release.yml/runs?event=workflow_dispatch&branch=main&per_page=50")"
            release_run_id="$(printf '%s' "$runs" | jq -r \
              --arg started "$dispatch_started" --arg sha "$EXPECTED_MAIN_SHA" '
                [.workflow_runs[] | select(.created_at >= $started and .head_sha==$sha)]
                | sort_by(.created_at) | last | .id // empty')"
            [[ -n "$release_run_id" ]] && break
            sleep 2
          done
          [[ "$release_run_id" =~ ^[0-9]+$ ]]
          echo "ISSUE782_RELEASE_RUN_ID=$release_run_id" >> "$GITHUB_ENV"
          echo "release_run_id=$release_run_id" >> "$GITHUB_OUTPUT"
          jq -n \
            --argjson runId "$release_run_id" \
            --arg dispatchStarted "$dispatch_started" \
            --arg sha "$EXPECTED_MAIN_SHA" \
            '{runId:$runId,target:"production",ref:"main",expectedSha:$sha,dispatchStarted:$dispatchStarted}' \
            > "$EVIDENCE_DIR/release-dispatch.json"
          gh run watch "$release_run_id" --exit-status --interval 15

      - name: Download and independently verify permanent release evidence
        id: release_evidence
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$EVIDENCE_DIR/permanent-release"
          gh run download "$ISSUE782_RELEASE_RUN_ID" --dir "$EVIDENCE_DIR/permanent-release"
          detail="$(find "$EVIDENCE_DIR/permanent-release" -name deployment-detail.json -type f -print -quit)"
          url_file="$(find "$EVIDENCE_DIR/permanent-release" -name deployment-url.txt -type f -print -quit)"
          integrity="$(find "$EVIDENCE_DIR/permanent-release" -name static-artifact-integrity.json -type f -print -quit)"
          test -f "$detail" -a -f "$url_file" -a -f "$integrity"
          deployment_id="$(jq -r '.id // .uid // empty' "$detail")"
          deployment_url="$(tr -d '\r\n' < "$url_file")"
