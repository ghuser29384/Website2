        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install and statically validate all one-use controller inputs
        shell: bash
        run: |
          set -euo pipefail
          npm ci
          npx playwright install --with-deps chromium
          docker pull "$POSTGRES_IMAGE"
          node --check "$RENDERER_PATH"
          node --check "$UAT_SCRIPT_PATH"
          ruby -e "require 'yaml'; YAML.parse_file('$WORKFLOW_PATH')"
          docker image inspect "$POSTGRES_IMAGE" --format '{{index .RepoDigests 0}}' \
            > "$EVIDENCE_DIR/postgres-image.txt"

      - name: Validate exact TLS-only production database target and immutable zero-state guard
        shell: bash
        run: |
          set -euo pipefail
          test -n "${PROD_SUPABASE_DB_URL:-}"
          echo "::add-mask::$PROD_SUPABASE_DB_URL"
          URL_TO_CHECK="$PROD_SUPABASE_DB_URL" node <<'NODE'
          const url = new URL(process.env.URL_TO_CHECK);
          const valid =
            ["postgres:", "postgresql:"].includes(url.protocol) &&
            decodeURIComponent(url.username) === process.env.EXPECTED_POOLER_USER &&
            url.hostname === process.env.EXPECTED_POOLER_HOST &&
            url.port === "5432" &&
            url.pathname === "/postgres" &&
            url.searchParams.get("sslmode") === "require" &&
            Boolean(url.password) &&
            !url.href.includes("hvmxfjjbdcgjjudmthdz");
          if (!valid) throw new Error("Refusing a database URL outside exact TLS-only Moral Trade production.");
          NODE
          cat > "$RUNNER_TEMP/issue782-guard.sql" <<'SQL'
          \set ON_ERROR_STOP on
          set statement_timeout = '60s';
          begin transaction read only;
          do $guard$
          declare
            expected jsonb := '[
              {"version":"20260806110000","name":"mpgf_pool_review_freeze","hash":"0913419d665fd69b3a80ea3e5c39a89111721e414b7520f0defc11f6965ecc3c"},
              {"version":"20260806143000","name":"mpgf_pool_publication_materialization","hash":"ee8ab4a2c52893ff9f2d8dfcbf7dc25370768af80e5401978f7c4b09e8cab9e8"},
              {"version":"20260806173000","name":"mpgf_dac_pledge_intent_ledger","hash":"36f558549361a1c0747dab5ecd545c74efbd42be14f6d634cb28e8b01f7c1e9c"},
              {"version":"20260807050000","name":"mpgf_dac_success_lapse","hash":"83d9432f90fb808302249b5b572029d68bfc9aa2be32afbaba710f8e341d0948"},
              {"version":"20260807100000","name":"mpgf_dac_public_terms_api","hash":"356d220c009dd6213b761712a30ce0124d95f075d5fdab5c44da3398a6265a0f"},
              {"version":"20260812073000","name":"mpgf_dac_terminal_event_constraint_reconciliation","hash":"a19653e57a20dff8d01e1dd54b4b77304fe0712fe3356820953945e7b9999cd2"},
              {"version":"20260812074500","name":"mpgf_dac_terminal_schema_reconciliation","hash":"d8dc2a55840425357c8859b87d26fba0415bb1a50c8e739518a88b9686142cbb"},
              {"version":"20260815010000","name":"mpgf_pool_lifecycle_event_ordering","hash":"1d60c1abc73c8842cdcd9694c77d0e29dac4fe1de98a496714c0f2f2f5619766"},
              {"version":"20260815011000","name":"mpgf_dac_terminal_guard_reconciliation","hash":"c64d521c6adb7a865d9ec5e2f25e70adb09f08f91e0f1bc0ec0610977aafd108"},
              {"version":"20260818173000","name":"mpgf_dac_public_goods_foundation_reconciliation","hash":"e89a199cbdbb767d88a03585764bce774f533449519b67d04c082683f0638aa0"},
              {"version":"20260818174000","name":"mpgf_dac_public_aggregate_column_privacy","hash":"0c3e7596f5f6b0d69d9438347f82ad79b6d0663511d3aec7cf333681fef9f581"}
            ]'::jsonb;
            item jsonb;
            observed_name text;
            observed_hash text;
            table_name text;
            row_count bigint;
          begin
            for item in select value from jsonb_array_elements(expected)
            loop
              select name,
                     case when statements is null or array_length(statements,1) is null then null
                          else encode(extensions.digest(convert_to(statements[1], 'UTF8'), 'sha256'),'hex') end
                into observed_name, observed_hash
              from supabase_migrations.schema_migrations
              where version = item->>'version';
              if not found or observed_name is distinct from item->>'name' or observed_hash is distinct from item->>'hash' then
                raise exception 'migration registry drift for %', item->>'version';
              end if;
            end loop;
            if (select count(*) from supabase_migrations.schema_migrations where version in (select value->>'version' from jsonb_array_elements(expected))) <> 11 then
              raise exception 'expected exactly eleven DAC registry rows';
            end if;
            foreach table_name in array array[
              'mpgf_pool_proposals','mpgf_pool_reviewers','mpgf_pool_proposal_versions','mpgf_pool_lifecycle_events',
              'mpgf_public_goods_match_pools','mpgf_public_goods_rounds','mpgf_public_goods_campaigns','mpgf_public_goods_pledges',
              'mpgf_dac_pledge_intents','mpgf_dac_pledge_events','mpgf_dac_campaign_outcomes'
            ] loop
              if to_regclass('public.'||table_name) is null then raise exception 'missing table %', table_name; end if;
              if not exists (
                select 1 from pg_class c join pg_namespace n on n.oid=c.relnamespace
                where n.nspname='public' and c.relname=table_name and c.relrowsecurity
              ) then raise exception 'RLS disabled on %', table_name; end if;
              execute format('select count(*) from public.%I', table_name) into row_count;
              if row_count <> 0 then raise exception 'nonzero authorized aggregate state on %', table_name; end if;
            end loop;
            if to_regprocedure('public.mpgf_approve_and_freeze_pool_proposal(uuid,uuid,text)') is null
               or to_regprocedure('public.mpgf_publish_pool_proposal(uuid,text,text,uuid,text)') is null
               or to_regprocedure('public.mpgf_create_dac_pledge(text,bigint,text,text,text)') is null
               or to_regprocedure('public.mpgf_review_dac_pledge_eligibility(uuid,uuid,text,integer,text)') is null
               or to_regprocedure('public.mpgf_finalize_dac_campaign(text,uuid,text)') is null
               or to_regprocedure('public.mpgf_public_dac_campaign_terms(text)') is null then
              raise exception 'required DAC function missing';
            end if;
            if has_table_privilege('anon','public.mpgf_public_goods_campaigns','SELECT')
               or has_table_privilege('authenticated','public.mpgf_public_goods_campaigns','SELECT')
               or has_table_privilege('anon','public.mpgf_dac_campaign_outcomes','SELECT')
               or has_table_privilege('authenticated','public.mpgf_dac_campaign_outcomes','SELECT') then
              raise exception 'unexpected table-level public select';
            end if;
            if not has_column_privilege('anon','public.mpgf_public_goods_campaigns','id','SELECT')
               or not has_column_privilege('authenticated','public.mpgf_public_goods_campaigns','id','SELECT')
               or has_column_privilege('anon','public.mpgf_public_goods_campaigns','published_by','SELECT')
               or has_column_privilege('authenticated','public.mpgf_public_goods_campaigns','published_by','SELECT')
               or not has_column_privilege('anon','public.mpgf_dac_campaign_outcomes','outcome_status','SELECT')
               or has_column_privilege('anon','public.mpgf_dac_campaign_outcomes','outcome_json','SELECT') then
              raise exception 'public/private column grant drift';
            end if;
            if (select count(*) from public.mpgf_public_goods_pledges where payment_intent_ref is not null or status='captured') <> 0 then
              raise exception 'payment reference drift';
            end if;
          end
          $guard$;
          select jsonb_build_object(
            'migrationRows',11,'requiredTables',11,'rlsEnabled',true,'requiredFunctions',6,
            'safeColumnReads',true,'privateColumnDenial',true,'authorizedAggregateRows',0,
            'paymentReferences',0,'checkedAt',clock_timestamp()
          );
          rollback;
          SQL
          docker run --rm -i "$POSTGRES_IMAGE" psql "$PROD_SUPABASE_DB_URL" \
            --no-psqlrc --set ON_ERROR_STOP=1 --tuples-only --no-align \
            < "$RUNNER_TEMP/issue782-guard.sql" | tee "$EVIDENCE_DIR/database-preflight.raw"
          grep -E '^\{' "$EVIDENCE_DIR/database-preflight.raw" | tail -n 1 > "$EVIDENCE_DIR/database-preflight.json"
          jq -e '.migrationRows==11 and .requiredTables==11 and .requiredFunctions==6 and .authorizedAggregateRows==0 and .paymentReferences==0' \
            "$EVIDENCE_DIR/database-preflight.json" >/dev/null

      - name: Pull exact production environment safely and require payment/provider modes disabled
        id: production_env
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .vercel
          printf '{"orgId":"%s","projectId":"%s"}\n' "$VERCEL_TEAM_ID" "$VERCEL_PROJECT_ID" > .vercel/project.json
          npx --yes "vercel@$VERCEL_CLI_VERSION" pull \
            --yes --environment=production --token="$VERCEL_TOKEN" \
            > "$RUNNER_TEMP/vercel-pull.log" 2>&1
          test -s .vercel/.env.production.local
          RAW_ENV=.vercel/.env.production.local OUTPUT_ENV="$RUNNER_TEMP/issue782-production-secrets.env" \
            node <<'NODE'
          const fs = require('node:fs');
          const text = fs.readFileSync(process.env.RAW_ENV, 'utf8');
          const parse = (value) => {
            const raw = value.trim();
            if (raw.startsWith('"') && raw.endsWith('"')) return JSON.parse(raw);
            if (raw.startsWith("'") && raw.endsWith("'")) return raw.slice(1,-1).replace(/'\\''/g, "'");
            return raw;
          };
          const values = new Map();
          for (const line of text.split(/\r?\n/)) {
            const index = line.indexOf('=');
            if (index <= 0) continue;
            values.set(line.slice(0,index), parse(line.slice(index+1)));
          }
          const required = ['SUPABASE_SERVICE_ROLE_KEY'];
          for (const key of required) if (!values.get(key)) throw new Error(`Missing ${key}`);
          const disabled = (value) => !value || ['0','false','disabled','off','none'].includes(String(value).trim().toLowerCase());
          for (const key of [
            'CONDITIONAL_PAYMENTS_MODE',
            'TRADE_DONATION_POOL_ENABLED',
            'TRADE_DONATION_POOL_MODE',
            'DIRECT_DONATION_UPGRADES_ENABLED',
            'DIRECT_DONATION_UPGRADE_MODE',
          ]) {
            if (!disabled(values.get(key))) throw new Error(`Payment/provider mode ${key} is not disabled.`);
          }
          if (values.has('ADMIN_EMAILS') && String(values.get('ADMIN_EMAILS')).trim() !== '') {
            throw new Error('ADMIN_EMAILS was unexpectedly present before one-use enablement.');
          }
          const config = fs.readFileSync('src/lib/supabase/config.ts','utf8');
          const url = values.get('NEXT_PUBLIC_SUPABASE_URL') ??
