      - name: Inspect exact deployment-scoped runtime logs before cleanup
        id: logs
        if: always()
        shell: bash
        run: |
          set -uo pipefail
          log_code=0
          mkdir -p "$EVIDENCE_DIR/runtime-logs"
          temp_id="${ISSUE782_TEMP_DEPLOYMENT_ID:-}"
          if [[ -z "$temp_id" && -s "$RUNNER_TEMP/issue782-temp-deployment-id" ]]; then
            temp_id="$(cat "$RUNNER_TEMP/issue782-temp-deployment-id")"
          fi
          if [[ -z "$temp_id" ]]; then
            jq -n --arg checkedAt "$(date -u +%FT%TZ)" \
              '{status:"not_applicable",reason:"no_temporary_deployment",checkedAt:$checkedAt}' \
              > "$EVIDENCE_DIR/runtime-logs/summary.json"
          else
            started="$(cat "$EVIDENCE_DIR/uat-started-at.txt" 2>/dev/null || true)"
            [[ -n "$started" ]] || started="$(date -u -d "@${ISSUE782_ALIAS_STARTED_EPOCH:-$(date +%s)}" +%FT%TZ)"
            completed="$(cat "$EVIDENCE_DIR/uat-completed-at.txt" 2>/dev/null || date -u +%FT%TZ)"
            raw="$RUNNER_TEMP/issue782-runtime-logs.ndjson"
            set +e
            npx --yes "vercel@$VERCEL_CLI_VERSION" logs \
              --project "$VERCEL_PROJECT_ID" \
              --deployment "$temp_id" \
              --environment production \
              --since "$started" \
              --until "$completed" \
              --limit 1000 \
              --json \
              --no-branch \
              --no-follow \
              --token="$VERCEL_TOKEN" \
              > "$raw" 2> "$RUNNER_TEMP/issue782-runtime-logs.stderr"
            cli_code=$?
            set -e
            [[ "$cli_code" -eq 0 ]] || log_code=118
            RAW_LOGS="$raw" OUTPUT_SUMMARY="$EVIDENCE_DIR/runtime-logs/summary.json" \
              STARTED="$started" COMPLETED="$completed" DEPLOYMENT_ID="$temp_id" \
              node <<'NODE' || log_code=119
            const fs = require('node:fs');
            const lines = fs.existsSync(process.env.RAW_LOGS)
              ? fs.readFileSync(process.env.RAW_LOGS, 'utf8').split(/\r?\n/).filter(Boolean)
              : [];
            const entries = [];
            for (const line of lines) {
              try { entries.push(JSON.parse(line)); } catch { /* CLI banners are not retained */ }
            }
            const text = JSON.stringify(entries);
            const statusOf = (entry) => Number(entry.statusCode ?? entry.status ?? entry.responseStatusCode ?? 0);
            const levelOf = (entry) => String(entry.level ?? entry.type ?? '').toLowerCase();
            const pathOf = (entry) => String(entry.requestPath ?? entry.path ?? entry.url ?? entry.route ?? '');
            const fiveXx = entries.filter((entry) => statusOf(entry) >= 500 && statusOf(entry) <= 599);
            const fourXx = entries.filter((entry) => statusOf(entry) >= 400 && statusOf(entry) <= 499);
            const errorLevel = entries.filter((entry) => ['error','fatal'].includes(levelOf(entry)));
            const authDenials = entries.filter((entry) => [401,403].includes(statusOf(entry)));
            const secretPatterns = [
              /eyJ[A-Za-z0-9_-]{12,}\.[A-Za-z0-9_-]{12,}\.[A-Za-z0-9_-]{8,}/,
              /Bearer\s+[A-Za-z0-9._~+/-]{20,}/i,
              /postgres(?:ql)?:\/\/[^\s"']+/i,
              /-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/,
              /(?:sk_(?:live|test)_|whsec_)[A-Za-z0-9_-]{8,}/i,
            ];
            const privatePatterns = [
              /[A-Z0-9._%+-]+@(?!qa\.moraltrade\.invalid\b)[A-Z0-9.-]+\.[A-Z]{2,}/i,
              /(?:access|refresh)[_-]?token["'=:\s]+[A-Za-z0-9._~+/-]{16,}/i,
            ];
            const migrationPattern = /migration|schema cache|relation [^ ]+ does not exist|column [^ ]+ does not exist/i;
            const paymentPattern = /stripe|paymentintent|setupintent|checkout|charge(?:d)?|capture(?:d)?|settlement|payout|provider request/i;
            const result = {
              schemaVersion: 1,
              status: 'inspected',
              deploymentId: process.env.DEPLOYMENT_ID,
              startedAt: process.env.STARTED,
              completedAt: process.env.COMPLETED,
              entryCount: entries.length,
              errorOrFatalCount: errorLevel.length,
              fiveXxCount: fiveXx.length,
              fourXxCount: fourXx.length,
              authDenialCount: authDenials.length,
              authFailureCluster: authDenials.length >= 10,
              migrationSignal: migrationPattern.test(text),
              paymentProviderSignal: paymentPattern.test(text),
              credentialSignal: secretPatterns.some((pattern) => pattern.test(text)),
              privateDataSignal: privatePatterns.some((pattern) => pattern.test(text)),
              fourXxClasses: [...new Set(fourXx.map((entry) => `${statusOf(entry)}:${pathOf(entry)}`))].slice(0, 50),
              inspectedAt: new Date().toISOString(),
              rawLogsRetained: false,
            };
            fs.writeFileSync(process.env.OUTPUT_SUMMARY, `${JSON.stringify(result, null, 2)}\n`, { mode: 0o600 });
            if (
              result.entryCount === 0 || result.errorOrFatalCount > 0 || result.fiveXxCount > 0 ||
              result.authFailureCluster || result.migrationSignal || result.paymentProviderSignal ||
              result.credentialSignal || result.privateDataSignal
            ) process.exitCode = 1;
          NODE
            rm -f "$raw" "$RUNNER_TEMP/issue782-runtime-logs.stderr"
          fi
          echo "exit_code=$log_code" >> "$GITHUB_OUTPUT"
          exit 0

      - name: Record bounded UAT database state before cleanup
        if: always()
        shell: bash
        run: |
          set -uo pipefail
          if [[ -s "$ISSUE782_MANIFEST_PATH" ]]; then
            proposals="$(jq -r '[.proposals[] | "'\''" + . + "'\''::uuid"] | join(",")' "$ISSUE782_MANIFEST_PATH")"
            campaigns="$(jq -r '[.proposals[] | "campaign-" + gsub("-";"")] | map("'"'"'" + . + "'"'"'") | join(",")' "$ISSUE782_MANIFEST_PATH")"
            docker run --rm -i "$POSTGRES_IMAGE" psql "$PROD_SUPABASE_DB_URL" \
              --no-psqlrc --set ON_ERROR_STOP=1 --tuples-only --no-align <<SQL \
              > "$EVIDENCE_DIR/pre-cleanup-state.raw" || true
            select jsonb_build_object(
              'proposals',(select count(*) from public.mpgf_pool_proposals where id in ($proposals)),
              'campaigns',(select count(*) from public.mpgf_public_goods_campaigns where id in ($campaigns)),
              'pledges',(select count(*) from public.mpgf_public_goods_pledges where campaign_id in ($campaigns)),
              'paymentReferences',(select count(*) from public.mpgf_public_goods_pledges where campaign_id in ($campaigns) and (payment_intent_ref is not null or status='captured')),
              'outcomes',(select count(*) from public.mpgf_dac_campaign_outcomes where campaign_id in ($campaigns)),
              'capturedAt',clock_timestamp()
            );
          SQL
            grep -E '^\{' "$EVIDENCE_DIR/pre-cleanup-state.raw" | tail -n 1 > "$EVIDENCE_DIR/pre-cleanup-state.json" || true
