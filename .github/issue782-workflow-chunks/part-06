          fi

      - name: Unconditionally restore aliases, remove temporary config, clean exact-owned state, and delete temporary deployment
        id: cleanup
        if: always()
        timeout-minutes: 30
        shell: bash
        run: |
          set -uo pipefail
          cleanup_code=0
          mkdir -p "$EVIDENCE_DIR/cleanup" "$EVIDENCE_DIR/aliases-restored"

          # Identify only this run's exact temporary deployment before touching aliases.
          temp_id="${ISSUE782_TEMP_DEPLOYMENT_ID:-}"
          discovered_started_epoch=""
          if [[ -z "$temp_id" && -s "$RUNNER_TEMP/issue782-temp-deployment-id" ]]; then
            temp_id="$(cat "$RUNNER_TEMP/issue782-temp-deployment-id")"
          fi
          if [[ -z "$temp_id" && -n "${ISSUE782_RELEASE_DISPATCH_EPOCH:-}" ]]; then
            since_ms="$(((ISSUE782_RELEASE_DISPATCH_EPOCH-5)*1000))"
            deployments="$RUNNER_TEMP/deployments-since-dispatch.json"
            if curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
              "https://api.vercel.com/v6/deployments?projectId=$VERCEL_PROJECT_ID&teamId=$VERCEL_TEAM_ID&since=$since_ms&limit=20" \
              > "$deployments"; then
              candidate_count="$(jq --arg original "$ORIGINAL_DEPLOYMENT_ID" --arg sha "$EXPECTED_MAIN_SHA" '[.deployments[]? | select(.id!=$original and .target=="production" and .meta.githubCommitSha==$sha)] | length' "$deployments")"
              if [[ "$candidate_count" = "1" ]]; then
                temp_id="$(jq -r --arg original "$ORIGINAL_DEPLOYMENT_ID" --arg sha "$EXPECTED_MAIN_SHA" '.deployments[] | select(.id!=$original and .target=="production" and .meta.githubCommitSha==$sha) | .id' "$deployments")"
                discovered_created_ms="$(jq -r --arg id "$temp_id" '.deployments[] | select(.id==$id) | (.created // .createdAt // 0)' "$deployments")"
                [[ "$discovered_created_ms" =~ ^[0-9]+$ ]] && discovered_started_epoch="$((discovered_created_ms/1000))"
              elif [[ "$candidate_count" -gt 1 ]]; then
                cleanup_code=98
              fi
            else
              cleanup_code=97
            fi
          fi
          if [[ -n "$temp_id" && "$temp_id" != "$ORIGINAL_DEPLOYMENT_ID" ]]; then
            temp_detail="$RUNNER_TEMP/exact-temp-deployment.json"
            if ! curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
              "https://api.vercel.com/v13/deployments/$temp_id?teamId=$VERCEL_TEAM_ID" > "$temp_detail" \
              || ! jq -e --arg id "$temp_id" --arg project "$VERCEL_PROJECT_ID" --arg sha "$EXPECTED_MAIN_SHA" '
                ((.id // .uid)==$id) and ((.projectId // .project.id // "")==$project) and (.meta.githubCommitSha==$sha)
              ' "$temp_detail" >/dev/null; then
              cleanup_code=96
              temp_id=""
            elif [[ -z "$discovered_started_epoch" ]]; then
              created_ms="$(jq -r '(.createdAt // .created // 0)' "$temp_detail")"
              [[ "$created_ms" =~ ^[0-9]+$ ]] && discovered_started_epoch="$((created_ms/1000))"
            fi
          fi

          # Restore only aliases currently owned by the exact temporary deployment; never clobber unknown state.
          for alias_name in moraltrade.org www.moraltrade.org; do
            key="${alias_name//./-}"
            current_path="$RUNNER_TEMP/alias-current-$key.json"
            if ! curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
              "https://api.vercel.com/v4/aliases/$alias_name?projectId=$VERCEL_PROJECT_ID&teamId=$VERCEL_TEAM_ID" \
              > "$current_path"; then
              cleanup_code=99
              continue
            fi
            current_id="$(jq -r '.deploymentId // .deployment.id // .deployment.uid // empty' "$current_path")"
            if [[ "$current_id" = "$ORIGINAL_DEPLOYMENT_ID" ]]; then
              :
            elif [[ -n "$temp_id" && "$current_id" = "$temp_id" ]]; then
              npx --yes "vercel@$VERCEL_CLI_VERSION" alias set \
                "$ORIGINAL_DEPLOYMENT_URL" "$alias_name" \
                --token="$VERCEL_TOKEN" \
                > "$RUNNER_TEMP/alias-restore-$key.log" 2>&1 || cleanup_code=101
            else
              echo "Refusing to overwrite unknown canonical alias state for $alias_name ($current_id)." >&2
              cleanup_code=100
            fi
          done
          for attempt in $(seq 1 40); do
            restored=true
            for alias_name in moraltrade.org www.moraltrade.org; do
              key="${alias_name//./-}"
              if ! curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
                "https://api.vercel.com/v4/aliases/$alias_name?projectId=$VERCEL_PROJECT_ID&teamId=$VERCEL_TEAM_ID" \
                > "$RUNNER_TEMP/alias-restored-$key.json"; then
                restored=false
                break
              fi
              if ! jq -e --arg alias "$alias_name" --arg project "$VERCEL_PROJECT_ID" --arg deployment "$ORIGINAL_DEPLOYMENT_ID" '
                (.alias==$alias) and (.projectId==$project) and ((.deploymentId // .deployment.id // .deployment.uid // "")==$deployment)
              ' "$RUNNER_TEMP/alias-restored-$key.json" >/dev/null; then
                restored=false
                break
              fi
              jq '{alias,projectId,deploymentId:(.deploymentId // .deployment.id // .deployment.uid)}' \
                "$RUNNER_TEMP/alias-restored-$key.json" > "$EVIDENCE_DIR/aliases-restored/$key.json"
            done
            [[ "$restored" == "true" ]] && break
            sleep 5
          done
          [[ "${restored:-false}" == "true" ]] || cleanup_code=102
          if [[ "${restored:-false}" == "true" ]]; then
            nonce="$EXPECTED_MAIN_SHA-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-cleanup"
            if ! curl -fsS -H 'Cache-Control: no-cache' \
              "https://www.moraltrade.org/moral-trade-live-create-router.js?integrity=$nonce" \
              -o "$RUNNER_TEMP/restored-critical-asset.js" \
              || ! cmp --silent public/moral-trade-live-create-router.js "$RUNNER_TEMP/restored-critical-asset.js"; then
              cleanup_code=118
            else
              sha256sum public/moral-trade-live-create-router.js "$RUNNER_TEMP/restored-critical-asset.js" \
                > "$EVIDENCE_DIR/cleanup/restored-critical-asset.sha256"
            fi
          fi

          # Remove only the exact temporary production ADMIN_EMAILS variable.
          envs="$RUNNER_TEMP/envs-cleanup.json"
          if curl -fsS -H "Authorization: Bearer $VERCEL_TOKEN" \
            "https://api.vercel.com/v10/projects/$VERCEL_PROJECT_ID/env?teamId=$VERCEL_TEAM_ID&decrypt=true&source=issue782-cleanup" \
            > "$envs"; then
            admin_count="$(jq '[.envs[]? | select(.key=="ADMIN_EMAILS" and ((.target|type)=="array" and (.target|index("production"))!=null or .target=="production"))] | length' "$envs")"
            if [[ "$admin_count" = "1" ]]; then
              exact_count="$(jq --arg value "${ISSUE782_REVIEWER_EMAIL:-}" '
                [.envs[]? | select(.key=="ADMIN_EMAILS" and .value==$value and ((.target|type)=="array" and (.target|index("production"))!=null))] | length
              ' "$envs")"
              if [[ "$exact_count" = "1" ]]; then
                env_id="$(jq -r --arg value "${ISSUE782_REVIEWER_EMAIL:-}" '.envs[] | select(.key=="ADMIN_EMAILS" and .value==$value) | .id' "$envs")"
                curl -fsS -X DELETE -H "Authorization: Bearer $VERCEL_TOKEN" \
                  "https://api.vercel.com/v9/projects/$VERCEL_PROJECT_ID/env/$env_id?teamId=$VERCEL_TEAM_ID" \
                  > /dev/null || cleanup_code=103
              else
                cleanup_code=104
              fi
            elif [[ "$admin_count" != "0" ]]; then
              cleanup_code=105
            fi
          else
            cleanup_code=106
          fi

          # Delete exact-owned application rows while preserving unknown state.
          if [[ -s "${ISSUE782_MANIFEST_PATH:-}" && -s "$GENERATED_DIR/issue782-cleanup.sql" ]]; then
            docker run --rm -i "$POSTGRES_IMAGE" psql "$PROD_SUPABASE_DB_URL" \
              --no-psqlrc --set ON_ERROR_STOP=1 \
              < "$GENERATED_DIR/issue782-cleanup.sql" \
              > "$EVIDENCE_DIR/cleanup/application-cleanup.log" 2>&1 || cleanup_code=107
          fi

          # Delete exact run-owned Auth users through the admin API.
          if [[ -s "$RUNNER_TEMP/issue782-production-secrets.env" && -s "${ISSUE782_MANIFEST_PATH:-}" ]]; then
            source "$RUNNER_TEMP/issue782-production-secrets.env"
            for role in creator reviewer pledger outsider; do
              user_id="$(jq -r --arg role "$role" '.users[$role].id // empty' "$ISSUE782_MANIFEST_PATH")"
              email="$(jq -r --arg role "$role" '.users[$role].email // empty' "$ISSUE782_MANIFEST_PATH")"
              if [[ -n "$user_id" && -n "$email" ]]; then
                metadata="$RUNNER_TEMP/user-before-delete-$role.json"
                status="$(curl -sS \
                  -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" \
                  -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY" \
                  -o "$metadata" -w '%{http_code}' \
                  "$NEXT_PUBLIC_SUPABASE_URL/auth/v1/admin/users/$user_id")"
                if [[ "$status" = "200" ]] && jq -e --arg id "$user_id" --arg email "$email" --arg namespace "$ISSUE782_NAMESPACE" '
                  .id==$id and ((.email // "")|ascii_downcase)==($email|ascii_downcase)
                  and ((.user_metadata // .raw_user_meta_data).qa_namespace==$namespace)
                  and ((.user_metadata // .raw_user_meta_data).qa_scope=="issue782_bounded_production_uat")
                ' "$metadata" >/dev/null; then
                  delete_status="$(curl -sS -X DELETE \
                    -H "apikey: $SUPABASE_SERVICE_ROLE_KEY" \
                    -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY" \
                    -o "$RUNNER_TEMP/user-delete-$role.json" -w '%{http_code}' \
                    "$NEXT_PUBLIC_SUPABASE_URL/auth/v1/admin/users/$user_id")"
                  [[ "$delete_status" = "200" || "$delete_status" = "204" ]] || cleanup_code=108
                elif [[ "$status" != "404" ]]; then
                  cleanup_code=109
                fi
              fi
            done
          fi

          # Independent exact-ID zero-residue and zero-payment proof.
