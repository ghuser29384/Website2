s gate."
new_direct_contract = "The confirmed Partner Webhook contract is exactly one `Authorization` header whose value is `Bearer <Auth Token>`, with the literal scheme, one ASCII space, and the private Auth Token. Missing, duplicated/coalesced, malformed, or incorrect authorization returns a generic `401` before body parsing or database access. A correct route ID remains defense in depth and cannot bypass this gate."
replace_exact(
    direct_doc,
    old_direct_contract,
    new_direct_contract,
    label="direct provider contract",
)
replace_exact(
    direct_doc,
    "Only the separately configured, private Partner Webhook authorization token may authenticate an inbound delivery after Every.org supplies the exact written header contract.",
    "Only the separately configured private Auth Token, presented through the exact `Authorization: Bearer <Auth Token>` contract, may authenticate an inbound delivery.",
    label="direct final route note",
)

env_example = Path(".env.example")
replace_exact(
    env_example,
    "# must be distinct. The path and metadata secrets must each be at least 32 random characters.",
    "# must be distinct. The route ID is non-secret; the metadata secret must be independent.",
    label="environment credential comment",
)

# Once the exact provider contract is known, configured staging environments with
# distinct directional credentials are ready for checkout. Preserve the bounded
# rendered-QA path as a commitments-only fallback when the private credential is absent.
replace_exact(
    direct_test,
    'test("staging search remains available while commitments require the bounded rendered-QA inspection mode", () => {',
    'test("staging exact auth enables checkout while bounded rendered-QA mode permits commitments without private auth", () => {',
    label="staging readiness test name",
)
replace_exact(
    direct_test,
    '''  assert.equal(local.readyForSearch, true);
  assert.equal(preview.readyForSearch, true);
  assert.equal(local.readyForCommitments, false);
  assert.equal(preview.readyForCommitments, false);''',
    '''  assert.equal(local.readyForSearch, true);
  assert.equal(preview.readyForSearch, true);
  assert.equal(local.readyForCommitments, true);
  assert.equal(preview.readyForCommitments, true);
  assert.equal(local.readyForCheckout, true);
  assert.equal(preview.readyForCheckout, true);''',
    label="authenticated staging readiness assertions",
)
replace_exact(
    direct_test,
    '''      ...stagingBase,
      DIRECT_DONATION_UPGRADE_RENDERED_QA_NO_SERVICE_ROLE: "true",''',
    '''      ...stagingBase,
      EVERY_ORG_PARTNER_WEBHOOK_AUTHORIZATION_TOKEN: "",
      DIRECT_DONATION_UPGRADE_RENDERED_QA_NO_SERVICE_ROLE: "true",''',
    label="rendered-QA missing private credential",
)

# Keep the route-ID source contract aligned with the now-confirmed sender-authentication
# API. The route ID remains defense in depth; request headers authenticate the sender.
route_id_source_contract = Path(
    "src/lib/every-org-webhook-route-id-source-contract.test.ts",
)
replace_exact(
    route_id_source_contract,
    '  const auth = route.indexOf("authenticateEveryOrgPartnerWebhookRequest()");',
    '  const auth = route.indexOf("authenticateEveryOrgPartnerWebhookRequest(request.headers)");',
    label="route-ID source-contract authentication call",
)

# Closed-scope assertions.
expected_changed = {
    ".env.example",
    "docs/direct-verified-donation-upgrade.md",
    "docs/every-org-pledge-donation-connector.md",
    "src/app/api/connectors/every-org/[routeId]/route.ts",
    "src/app/api/mpgf/every-org/webhook/route.ts",
    "src/lib/direct-donation-upgrade-source-contract.test.ts",
    "src/lib/direct-donation-upgrade.test.ts",
    "src/lib/every-org-partner-webhook-auth.test.ts",
    "src/lib/every-org-partner-webhook-auth.ts",
    "src/lib/every-org-webhook-route-id-source-contract.test.ts",
    "src/lib/trade-donation.test.ts",
}
changed = {
    line.strip()
    for line in subprocess.run(
        ["git", "diff", "--name-only"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    if line.strip()
}
if changed != expected_changed:
    raise SystemExit(
        f"Refusing unexpected Phase B changed paths: expected {sorted(expected_changed)}, got {sorted(changed)}",
    )

remaining_unconfirmed = subprocess.run(
    [
        "git",
        "grep",
        "-n",
        "unconfirmed",
        "--",
        ".env.example",
        "docs/direct-verified-donation-upgrade.md",
        "docs/every-org-pledge-donation-connector.md",
        "src/app/api/connectors/every-org/[routeId]/route.ts",
        "src/app/api/mpgf/every-org/webhook/route.ts",
        "src/lib/direct-donation-upgrade-source-contract.test.ts",
        "src/lib/direct-donation-upgrade.test.ts",
        "src/lib/every-org-partner-webhook-auth.test.ts",
        "src/lib/every-org-partner-webhook-auth.ts",
        "src/lib/every-org-webhook-route-id-source-contract.test.ts",
        "src/lib/trade-donation.test.ts",
    ],
    check=False,
    capture_output=True,
    text=True,
)
if remaining_unconfirmed.returncode not in (0, 1):
    raise SystemExit(remaining_unconfirmed.stderr)
if remaining_unconfirmed.stdout.strip():
    raise SystemExit(
        "Refusing residual unconfirmed-provider language:\n"
        + remaining_unconfirmed.stdout,
    )

zero_arg_calls = subprocess.run(
    [
        "git",
        "grep",
        "-n",
        "authenticateEveryOrgPartnerWebhookRequest()",
        "--",
        "src",
    ],
    check=False,
    capture_output=True,
    text=True,
)
if zero_arg_calls.returncode not in (0, 1):
    raise SystemExit(zero_arg_calls.stderr)
if zero_arg_calls.stdout.strip():
    raise SystemExit("Refusing zero-argument authenticator calls:\n" + zero_arg_calls.stdout)

print("Every.org exact Authorization Bearer contract applied.")