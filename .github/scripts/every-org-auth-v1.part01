led.some((mechanism) => !mechanism.ready)) {
    return {
      accepted: false,
      status: "mechanism_not_ready",
      mechanisms: mechanismNames,
      environment: null,
    };
  }

  const environments = new Set(enabled.map((mechanism) => mechanism.environment));
  if (environments.size !== 1 || enabled[0]?.environment === null) {
    return {
      accepted: false,
      status: "environment_ambiguous",
      mechanisms: mechanismNames,
      environment: null,
    };
  }

  const canonicalRouteId = enabled[0]?.webhookRouteId ?? "";
  if (
    !isValidEveryOrgWebhookRouteId(canonicalRouteId) ||
    enabled.some(
      (mechanism) =>
        !isValidEveryOrgWebhookRouteId(mechanism.webhookRouteId) ||
        mechanism.webhookRouteId !== canonicalRouteId,
    )
  ) {
    return {
      accepted: false,
      status: "route_id_ambiguous",
      mechanisms: mechanismNames,
      environment: null,
    };
  }

  if (
    !isValidEveryOrgWebhookRouteId(candidateRouteId) ||
    candidateRouteId !== canonicalRouteId
  ) {
    return {
      accepted: false,
      status: "route_id_mismatch",
      mechanisms: mechanismNames,
      environment: null,
    };
  }

  return {
    accepted: true,
    status: "accepted",
    mechanisms: mechanismNames,
    environment: enabled[0]?.environment ?? null,
  };
}
'''

Path("src/lib/every-org-partner-webhook-auth.ts").write_text(AUTH_SOURCE)

for route_name in [
    "src/app/api/connectors/every-org/[routeId]/route.ts",
    "src/app/api/mpgf/every-org/webhook/route.ts",
]:
    replace_exact(
        Path(route_name),
        "authenticateEveryOrgPartnerWebhookRequest();",
        "authenticateEveryOrgPartnerWebhookRequest(request.headers);",
        label="request-header authentication call",
    )

# Focused authenticator tests.
auth_test = Path("src/lib/every-org-partner-webhook-auth.test.ts")
replace_exact(
    auth_test,
    "  authenticateEveryOrgPartnerWebhookRequest,\n"
    "  EVERY_ORG_PARTNER_WEBHOOK_AUTHORIZATION_CONTRACT_STATUS,\n"
    "  getEveryOrgCredentialConfiguration,\n",
    "  authenticateEveryOrgPartnerWebhookRequest,\n"
    "  EVERY_ORG_PARTNER_WEBHOOK_AUTHORIZATION_CONTRACT_STATUS,\n"
    "  EVERY_ORG_PARTNER_WEBHOOK_AUTHORIZATION_HEADER,\n"
    "  EVERY_ORG_PARTNER_WEBHOOK_AUTHORIZATION_VALUE_PREFIX,\n"
    "  getEveryOrgCredentialConfiguration,\n",
    label="auth constants import",
)
replace_exact(
