+
+test("independent institutional participation remains first-class and reduced", () => {
+  expectAll(individualPage, [
+    /Acting as: Personal \/ independent/,
+    /Opportunities/,
+    /Matches/,
+    /Deals/,
+    /Obligations/,
+    /Evidence/,
