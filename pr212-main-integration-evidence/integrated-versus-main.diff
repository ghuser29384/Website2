+
+function expectAll(source: string, patterns: RegExp[], context: string) {
+  for (const pattern of patterns) assert.match(source, pattern, `${context}: ${pattern}`);
+}
+
+test("Beta 1 exposes the complete transaction-integrity workflow", () => {
