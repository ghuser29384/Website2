+name: PR 212 clean reconstruction gates
+
+on:
+  push:
+    branches:
+      - agent/pr212-clean-reconstruction-20260730
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: pr212-clean-reconstruction-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  validate:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 50
+    env:
+      RECONSTRUCTION_BASE: 9ec3bd79618a704469bc4f3547d2d8a1e4dc2730
+    steps:
+      - name: Check out exact reconstruction commit
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: npm
+
+      - name: Install dependencies with transient-registry retry
+        shell: bash
+        run: |
+          set -euo pipefail
+          for attempt in 1 2 3 4; do
+            if npm ci; then
+              exit 0
+            fi
+            if (( attempt == 4 )); then
+              echo "npm ci failed after four attempts." >&2
+              exit 1
+            fi
+            sleep $((attempt * 20))
+          done
+
+      - name: Verify reviewable source and institutional contracts
+        shell: bash
+        run: |
+          set -euo pipefail
+          git merge-base --is-ancestor "$RECONSTRUCTION_BASE" HEAD
+          git diff --check "$RECONSTRUCTION_BASE" HEAD
+          cat > /tmp/expected-files.txt <<'FILES'
+          .github/scripts/institutional-trade-qa-e2e.mjs
+          .github/workflows/institutional-trade-qa.yml
+          .github/workflows/pr212-clean-reconstruction-gates.yml
+          src/app/institutions/[organizationId]/deals/[dealId]/page.tsx
+          src/app/institutions/[organizationId]/page.tsx
+          src/app/institutions/actions.ts
+          src/app/institutions/individual/deals/[dealId]/page.tsx
+          src/components/institutions/institutional-deal-workspace.tsx
+          src/components/institutions/institutional-organization-administration.tsx
+          src/components/institutions/institutional-pool-workspace.tsx
+          src/institutional-authorization-snapshot.test.ts
+          src/institutional-individual-capacity.test.ts
+          src/institutional-product-completeness.test.ts
+          src/institutional-trade-migration.test.ts
+          src/institutional-trade-wiring.test.ts
+          src/lib/institutional-data.ts
+          src/lib/institutional-trade.ts
+          supabase/migrations/20260726123000_institutional_trade_system.sql
+          FILES
+          git diff --name-only "$RECONSTRUCTION_BASE" HEAD | sort > /tmp/actual-files.txt
+          sort -o /tmp/expected-files.txt /tmp/expected-files.txt
+          diff -u /tmp/expected-files.txt /tmp/actual-files.txt
+          node --import tsx --test \
+            src/institutional-authorization-snapshot.test.ts \
+            src/institutional-individual-capacity.test.ts \
+            src/institutional-product-completeness.test.ts \
+            src/institutional-trade-migration.test.ts \
+            src/institutional-trade-wiring.test.ts \
+            src/lib/institutional-trade.test.ts \
+            src/lib/institutional-webhooks.test.ts
+          node --check .github/scripts/institutional-trade-qa-e2e.mjs
+
+      - name: Require absolute TypeScript success
+        run: npx tsc --noEmit --pretty false
+
+      - name: Require absolute ESLint success
+        run: npm run lint
+
+      - name: Require absolute production build success
+        run: npm run build
